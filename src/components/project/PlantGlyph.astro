---
// Decorative plant glyph: a cyan ring with a hot core, scaled down from `.node--plant` in GridMap.
// `morph`: the hero glyph that the map's plant glyph morphs into (view-transition-name `plant-glyph`).
// Set it on one glyph per page only: view-transition names must be unique.
interface Props {
  size?: number;
  class?: string;
  morph?: boolean;
}
const { size = 22, class: className, morph = false } = Astro.props;
---

<span
  class:list={['plant-glyph', className, { 'plant-glyph--morph': morph }]}
  id={morph ? 'plant-glyph-morph' : undefined}
  style={`--size:${size}px`}
  aria-hidden="true">
  <span class="plant-glyph__core"></span>
</span>

<style>
  .plant-glyph {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    border: 1.5px solid var(--cyan);
    background: radial-gradient(circle, rgba(var(--cyan-rgb), 0.22) 0%, var(--bg) 70%);
    box-shadow: 0 0 10px rgba(var(--cyan-rgb), 0.3);
  }
  .plant-glyph--morph {
    view-transition-name: plant-glyph;
  }
  @media (prefers-reduced-motion: reduce) {
    .plant-glyph--morph {
      view-transition-name: none;
    }
  }
  .plant-glyph__core {
    width: calc(var(--size) * 0.3);
    height: calc(var(--size) * 0.3);
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 calc(var(--size) * 0.3) calc(var(--size) * 0.065) rgba(var(--cyan-rgb), 0.8);
  }
</style>
