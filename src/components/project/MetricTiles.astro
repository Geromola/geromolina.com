---
interface Props {
  metrics: { value: string; label: string }[];
}
const { metrics } = Astro.props;
---

<ul class="metrics" aria-label="Key numbers">
  {
    metrics.map((m) => (
      <li class="metric glass">
        <span class="metric__value mono">{m.value}</span>
        <span class="metric__label">{m.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .metrics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .metrics {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem 1.375rem;
    border-radius: var(--radius-lg);
  }
  .metric__value {
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--cyan);
  }
  .metric__label {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--muted);
  }
</style>
