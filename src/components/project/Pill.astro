---
// Link styled as a pill (default) or a full-width button (block).
interface Props {
  href: string;
  newTab?: boolean;
  variant?: 'pill' | 'compact' | 'block';
  class?: string;
}
const { href, newTab = false, variant = 'pill', class: className } = Astro.props;
---

<a
  class:list={['pill', `pill--${variant}`, className]}
  href={href}
  target={newTab ? '_blank' : undefined}
  rel={newTab ? 'noopener' : undefined}
>
  <slot />
</a>

<style>
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--cyan-rgb), 0.35);
    background: rgba(var(--cyan-rgb), 0.08);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 100ms ease-out,
      background-color 150ms ease-out,
      border-color 150ms ease-out;
  }
  .pill:hover {
    background: rgba(var(--cyan-rgb), 0.14);
    border-color: rgba(var(--cyan-rgb), 0.55);
  }
  .pill:active {
    transform: scale(0.97);
  }
  .pill:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
    border-radius: 999px;
  }
  .pill--compact {
    min-height: 2.25rem;
    padding: 0 0.875rem;
    font-size: 0.875rem;
  }
  /* keep a 44px touch target around the compact pill */
  .pill--compact::after {
    content: '';
    position: absolute;
    inset: -4px;
  }
  .pill--block {
    display: flex;
    width: 100%;
    min-height: 3rem;
    border-radius: var(--radius-md);
  }
  .pill--block:focus-visible {
    border-radius: var(--radius-md);
  }
  @media (prefers-reduced-motion: reduce) {
    .pill {
      transition: none;
    }
  }
  @media (prefers-contrast: more) {
    .pill {
      border-color: var(--cyan);
      background: var(--bg-raise);
    }
  }
</style>
