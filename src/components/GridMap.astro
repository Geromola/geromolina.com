---
import { getCollection } from 'astro:content';
import type { MapNode } from '../grid/nodes';
import { LEVELS } from '../grid/game';

const MAP_NODES: MapNode[] = (await getCollection('nodes'))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order);

// A circle as a path (starts at the top, clockwise), so `pathLength` works everywhere.
const RING = 'M50 4 a46 46 0 1 1 0 92 a46 46 0 1 1 0 -92';
---

<section
  class="map"
  data-map
  data-nodes={JSON.stringify(MAP_NODES)}
  aria-label="Grid operator puzzle. Place transformers on junctions to step power up to high voltage and back down, so it reaches the target nodes with little lost as heat. Each node is a link; the full list is in Every node on the grid, below.">
  <canvas class="map__layer" data-mesh aria-hidden="true"></canvas>
  <canvas class="map__layer" data-electrons aria-hidden="true"></canvas>
  <div class="map__vignette" aria-hidden="true"></div>

  <header class="hero">
    <p class="hero__kicker mono" data-hero-block>Geronimo Molina</p>
    <h1 class="hero__name" data-hero-block>Gero</h1>
    <p class="hero__line" data-hero-block>MBA + MEng Candidate · UC Berkeley, California</p>
  </header>

  <div class="xfs" data-xfs>
    <div class="xf xf--ghost" data-ghost aria-hidden="true">
      <span class="xf__disc">
        <svg class="xf__coil" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <circle cx="12" cy="16" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <circle cx="20" cy="16" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        </svg>
      </span>
    </div>
  </div>
  <template data-xf-template>
    <button type="button" class="xf" aria-label="Transformer. Click to remove, drag to move.">
      <span class="xf__disc">
        <svg class="xf__coil" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
          <circle cx="12" cy="16" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <circle cx="20" cy="16" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        </svg>
      </span>
    </button>
  </template>

  <nav class="nodes" id="grid-nodes" aria-label="Grid">
    {
      MAP_NODES.map((n, i) => (
        <a
          class={`node node--${n.kind}`}
          data-node={i}
          href={n.href}
          style={`--x:${n.land[0]};--y:${n.land[1]};--xp:${n.port[0]};--yp:${n.port[1]}`}
        >
          <span class="node__glyph" aria-hidden="true">
            <svg class="node__ring" viewBox="0 0 100 100">
              <path class="node__ring-base" d={RING} pathLength="100" />
              <path class="node__ring-fill" d={RING} pathLength="100" data-ring />
            </svg>
            {n.kind === 'plant' && <span class="node__charge" />}
            {n.kind === 'plant' && <span class="node__core" />}
            {n.locked && (
              <svg viewBox="0 0 16 16" width="14" height="14">
                <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
              </svg>
            )}
          </span>
          <span class="node__label">
            <span class="node__kicker mono">{n.kicker}</span>
            <span class="node__title">{n.title}</span>
          </span>
        </a>
      ))
    }
  </nav>

  <aside class="panel glass" data-panel aria-label="Grid operator">
    <button
      class="panel__chip mono"
      data-chip
      type="button"
      aria-expanded="false"
      aria-controls="grid-panel-body">
      <span data-chip-text>Lv 1</span>
    </button>
    <div class="panel__body" id="grid-panel-body">
      <div class="panel__head">
        <span class="panel__level mono" data-level-label>Level 1 / {LEVELS.length}</span>
        <div class="panel__levels" role="group" aria-label="Levels">
          {
            LEVELS.map((l, i) => (
              <button
                type="button"
                class="panel__ldot"
                data-level={i}
                aria-label={`Level ${i + 1}: ${l.title}`}
                disabled={i > 0}
              />
            ))
          }
        </div>
      </div>
      <p class="panel__title" data-title>{LEVELS[0].title}</p>
      <p class="panel__objective" data-objective></p>
      <div class="panel__budget" data-budget role="img"></div>
      <div class="panel__eff">
        <div class="panel__stat">
          <span class="panel__label mono">Efficiency</span>
          <span class="panel__big mono" data-eff>0%</span>
        </div>
        <div class="panel__stars" data-stars role="img" aria-label="Not cleared yet">
          <span>★</span><span>★</span><span>★</span>
        </div>
      </div>
      <dl class="panel__row">
        <div class="panel__stat">
          <dt class="panel__label mono">Delivered</dt>
          <dd class="panel__small mono" data-delivered>0.0 MW</dd>
        </div>
        <div class="panel__stat">
          <dt class="panel__label mono">Lost as heat</dt>
          <dd class="panel__small panel__small--heat mono" data-lost>0.0 MW</dd>
        </div>
      </dl>
      <ul class="panel__loads" data-loads aria-label="Target loads"></ul>
      <div class="panel__actions">
        <button type="button" class="pill" data-reset>Reset</button>
        <button type="button" class="pill pill--next" data-next disabled>Next</button>
      </div>
    </div>
  </aside>

  <p class="visually-hidden" data-live role="status" aria-live="polite"></p>
  <div class="toast glass" data-toast>
    <span class="toast__bolt" aria-hidden="true">⚡</span>
    <span data-toast-text></span>
  </div>
</section>

<script>
  import { mountGrid } from '../grid/main';
  import type { MapNode } from '../grid/nodes';
  const root = document.querySelector<HTMLElement>('[data-map]');
  if (root) mountGrid(root, JSON.parse(root.dataset.nodes ?? '[]') as MapNode[]);
</script>

<style>
  .map {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    background: radial-gradient(120% 90% at 70% 30%, #08121c 0%, var(--bg) 60%);
  }
  .map :is(a, button:not(:disabled)) {
    cursor: pointer;
  }
  .map__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .map__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(130% 100% at 50% 40%, transparent 55%, rgba(4, 7, 11, 0.85) 100%),
      linear-gradient(to bottom, transparent 75%, var(--bg) 100%);
  }

  /* ---------- hero ---------- */
  .hero {
    position: absolute;
    top: clamp(1.5rem, 7vh, 4.5rem);
    left: var(--gutter);
    max-width: 34rem;
    pointer-events: none;
    z-index: 2;
  }
  .hero__kicker {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .hero__name {
    margin: 0;
    font-size: clamp(5rem, 15vw, 11.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.045em;
    background: linear-gradient(180deg, #fff 30%, #9fdcec 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 28px rgba(var(--cyan-rgb), 0.18));
  }
  .hero__line {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink-2);
  }

  /* ---------- transformers ---------- */
  .xfs {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .xf {
    --s: 1;
    position: absolute;
    left: -20px;
    top: -20px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--hot);
    pointer-events: auto;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    will-change: transform;
  }
  .xf__disc {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 10px rgba(var(--cyan-rgb), 0.18);
  }
  .xf__coil {
    flex: none;
    filter: drop-shadow(0 0 4px rgba(var(--cyan-rgb), 0.55));
  }
  .xf--ghost {
    opacity: 0;
    pointer-events: none;
  }
  .xf--ghost.is-visible {
    opacity: 0.4;
  }
  .xf.is-leaving {
    pointer-events: none;
  }
  .xf.is-dragging {
    z-index: 1;
  }

  /* ---------- nodes ---------- */
  .nodes {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .node {
    --pulse: 0;
    --spark: 0;
    position: absolute;
    left: calc(var(--x) * 100%);
    top: calc(var(--y) * 100%);
    width: 0;
    height: 0;
    text-decoration: none;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 250ms ease-out;
  }
  @media (orientation: portrait) {
    .node {
      left: calc(var(--xp) * 100%);
      top: calc(var(--yp) * 100%);
    }
  }
  .node.is-idle {
    opacity: 0.55;
  }
  .node__glyph {
    --size: 14px;
    position: absolute;
    left: calc(var(--size) / -2);
    top: calc(var(--size) / -2);
    width: var(--size);
    height: var(--size);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid rgba(232, 241, 245, 0.7);
    box-shadow: 0 0 calc(6px + var(--pulse) * 26px) rgba(var(--cyan-rgb), calc(0.15 + var(--pulse) * 0.5));
    transform: scale(calc(1 + var(--pulse) * 0.12));
    transition: transform 100ms ease-out, border-color 150ms ease-out;
  }
  /* overvoltage flash */
  .node__glyph::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: inherit;
    border: 1.5px solid rgba(var(--amber-rgb), var(--spark));
    box-shadow: 0 0 calc(var(--spark) * 22px) rgba(var(--amber-rgb), calc(var(--spark) * 0.8));
    pointer-events: none;
  }
  /* generous hit area (≈10px beyond the glyph) */
  .node__glyph::after {
    content: '';
    position: absolute;
    inset: -12px;
    border-radius: 50%;
  }
  .node--plant .node__glyph {
    --size: 46px;
    border-color: var(--cyan);
    background: radial-gradient(circle, rgba(var(--cyan-rgb), 0.22) 0%, var(--bg) 70%);
  }
  /* charge-up arc: a bright ring swept 0→360° by --charge (a Spring in main.ts) */
  .node--plant {
    --charge: 0;
  }
  .node__charge {
    position: absolute;
    inset: -9.5px;
    border-radius: 50%;
    pointer-events: none;
    -webkit-mask-image: conic-gradient(#000 calc(var(--charge) * 1turn), transparent 0);
    mask-image: conic-gradient(#000 calc(var(--charge) * 1turn), transparent 0);
  }
  .node__charge::before {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 2px solid var(--hot);
    box-shadow:
      0 0 8px rgba(var(--cyan-rgb), 0.9),
      inset 0 0 6px rgba(var(--cyan-rgb), 0.6);
  }
  .node__core {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 14px 3px rgba(var(--cyan-rgb), 0.8);
  }
  .node--substation .node__glyph {
    --size: 34px;
    border-radius: 10px;
    border-color: var(--amber);
    color: var(--amber);
    box-shadow: 0 0 calc(6px + var(--pulse) * 26px) rgba(var(--amber-rgb), calc(0.15 + var(--pulse) * 0.5));
  }
  /* The link itself is a zero-size anchor: show its focus ring on the glyph. */
  .node:focus-visible {
    outline: none;
  }
  .node:focus-visible .node__glyph {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
  }
  .node:active .node__glyph {
    transform: scale(0.92);
  }
  .node.is-hot .node__glyph {
    border-color: var(--hot);
  }

  /* target-load ring: dashed muted when unlit, fills cyan as it lights */
  .node__ring {
    position: absolute;
    inset: -8px;
    width: calc(100% + 16px);
    height: calc(100% + 16px);
    overflow: visible;
    pointer-events: none;
    display: none;
    transform: scale(calc(1 + var(--pulse) * 0.16));
  }
  .node.is-target .node__ring {
    display: block;
  }
  .node__ring path {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .node__ring-base {
    stroke: var(--muted);
    stroke-dasharray: 4 4;
  }
  .node__ring-fill {
    stroke: var(--cyan);
    stroke-dasharray: 0 100;
  }
  .node.is-lit .node__ring-fill {
    filter: drop-shadow(0 0 calc(3px + var(--pulse) * 8px) rgba(var(--cyan-rgb), 0.7));
  }
  .node.is-lit .node__ring-base {
    stroke: transparent;
  }

  .node__label {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(calc(var(--label-gap, 18px)), -50%);
    display: grid;
    white-space: nowrap;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    transition: color 150ms ease-out;
    /* Only the glyph is a pointer target, so labels never swallow junction clicks. */
    pointer-events: none;
  }
  .node--plant {
    --label-gap: 34px;
  }
  .node--substation {
    --label-gap: 28px;
  }
  .node--section.is-target {
    --label-gap: 22px;
  }
  .node--flip .node__label {
    left: auto;
    right: 0;
    text-align: right;
    transform: translate(calc(var(--label-gap, 18px) * -1), -50%);
  }
  .node__kicker {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .node--plant .node__kicker {
    color: var(--cyan);
  }
  .node--substation .node__kicker {
    color: var(--amber);
  }
  .node__title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-shadow: 0 1px 12px var(--bg), 0 0 2px var(--bg);
  }
  .node--section .node__title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .node.is-hot .node__title {
    color: #fff;
  }

  /* ---------- level panel ---------- */
  .panel {
    position: absolute;
    z-index: 5;
    left: var(--gutter);
    bottom: var(--gutter);
    width: 18.5rem;
    border-radius: var(--radius-lg);
    padding: 1rem 1rem 0.875rem;
  }
  .panel__chip {
    display: none;
  }
  .panel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .panel__level {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .panel__levels {
    display: flex;
    margin-right: -6px;
  }
  .panel__ldot {
    appearance: none;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .panel__ldot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    box-sizing: border-box;
    border: 1.5px solid var(--ink-2);
    transition: background 150ms ease-out, border-color 150ms ease-out;
  }
  .panel__ldot[aria-current='step']::before {
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 8px rgba(var(--cyan-rgb), 0.6);
  }
  .panel__ldot:disabled::before {
    border-color: transparent;
    background: rgba(255, 255, 255, 0.14);
  }
  .panel__ldot:not(:disabled):active {
    transform: scale(0.9);
  }
  .panel__title {
    margin: 0.5rem 0 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .panel__objective {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .panel__budget {
    display: flex;
    gap: 6px;
    margin-top: 0.625rem;
    will-change: transform;
  }
  .panel__budget :global(span) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    box-sizing: border-box;
    border: 1.5px solid var(--hot);
    opacity: 0.45;
  }
  .panel__budget :global(span.is-left) {
    background: var(--hot);
    opacity: 1;
    box-shadow: 0 0 6px rgba(var(--cyan-rgb), 0.5);
  }
  .panel__eff {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 0.75rem;
  }
  .panel__stat {
    display: grid;
    gap: 0.125rem;
    margin: 0;
  }
  .panel__label {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .panel__big {
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--cyan);
    transition: color 200ms ease-out;
  }
  .panel__big[data-state='low'] {
    color: var(--amber);
  }
  .panel__big[data-state='won'] {
    color: var(--hot);
    text-shadow: 0 0 14px rgba(var(--cyan-rgb), 0.45);
  }
  .panel__stars {
    display: flex;
    gap: 2px;
    padding-bottom: 0.25rem;
    font-size: 1.125rem;
    line-height: 1;
  }
  .panel__stars span {
    display: inline-block;
    color: rgba(255, 255, 255, 0.18);
    transform: scale(0);
  }
  .panel__stars span.is-on {
    color: var(--hot);
    text-shadow: 0 0 10px rgba(var(--cyan-rgb), 0.6);
  }
  .panel__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0.625rem 0 0;
    padding-top: 0.625rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .panel__small {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .panel__small--heat {
    color: var(--amber);
  }
  .panel__loads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .panel__loads :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem 0.25rem 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.75rem;
    color: var(--ink-2);
    transition: background 200ms ease-out, color 200ms ease-out;
  }
  .panel__loads :global(li svg circle) {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 2.2 2.2;
  }
  .panel__loads :global(li.is-lit) {
    background: rgba(var(--cyan-rgb), 0.12);
    color: var(--ink);
  }
  .panel__loads :global(li.is-lit svg circle) {
    stroke: var(--cyan);
    stroke-dasharray: none;
  }
  .panel__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }
  .pill {
    position: relative;
    appearance: none;
    flex: 1;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    color: var(--ink-2);
    border-radius: 999px;
    font: 500 0.8125rem/1 var(--font);
    transition: transform 100ms ease-out, background 150ms ease-out, color 150ms ease-out, opacity 150ms ease-out;
  }
  /* 44px hit area */
  .pill::before {
    content: '';
    position: absolute;
    inset: -4px 0;
  }
  .pill:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.08);
  }
  .pill:active:not(:disabled) {
    transform: scale(0.96);
  }
  .pill--next:not(:disabled) {
    border-color: rgba(var(--cyan-rgb), 0.4);
    background: rgba(var(--cyan-rgb), 0.14);
    color: var(--cyan);
  }
  .pill--next:hover:not(:disabled) {
    background: rgba(var(--cyan-rgb), 0.22);
  }
  .pill:disabled {
    opacity: 0.4;
  }

  /* ---------- toast ---------- */
  .toast {
    position: absolute;
    z-index: 6;
    right: var(--gutter);
    bottom: var(--gutter);
    width: min(26rem, calc(100% - 21rem - 2 * var(--gutter)));
    display: flex;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.2, 0.9, 0.3, 1);
    pointer-events: none;
  }
  .toast.is-visible {
    opacity: 1;
    transform: none;
  }
  .toast__bolt {
    color: var(--amber);
  }

  /* ---------- phones and tablets (≤ 1024px): the level panel collapses to a chip ---------- */
  @media (max-width: 1024px) {
    .panel {
      left: 50%;
      transform: translateX(-50%);
      width: auto;
      padding: 0;
      border-radius: 999px;
    }
