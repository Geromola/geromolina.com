---
import Section from './Section.astro';

interface Fact {
  title: string;
  rest: string;
  href?: string;
}

const facts: Fact[] = [
  { title: 'Regional Muay Thai champion', rest: 'At 16.' },
  { title: 'Founded a cycling team', rest: "Mastercard Advisors' first regional one." },
  {
    title: 'Published in the ACS Journal of Chemical Education',
    rest: 'LEDs as voltage generators, with homemade solar electrolysis (2021).',
    href: 'https://doi.org/10.1021/acs.jchemed.1c00093',
  },
  { title: 'Taught STEM to 250+ at-risk students', rest: 'Through a digital course I built as a volunteer.' },
];
---

<Section id="off-the-grid" kicker="NODE · OFF THE GRID" title="Off the grid">
  <ul class="facts" role="list">
    {
      facts.map((f, i) => {
        const index = String(i + 1).padStart(2, '0');
        const body = (
          <>
            <span class="fact__index mono" aria-hidden="true">{index}</span>
            <h3 class="fact__title">{f.title}</h3>
            <p class="fact__rest">{f.rest}</p>
          </>
        );
        return (
          <li class="fact-item">
            {f.href ? (
              <a class="fact glass fact--link" href={f.href} target="_blank" rel="noopener">
                {body}
                <span class="fact__out mono" aria-hidden="true">DOI ↗</span>
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            ) : (
              <div class="fact glass">{body}</div>
            )}
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .fact-item {
    display: flex;
  }
  .fact {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }
  .fact__index {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .fact__title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .fact__rest {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .fact--link {
    text-decoration: none;
    transition: border-color 150ms ease-out, transform 100ms ease-out;
  }
  .fact__out {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--cyan);
  }
  .fact--link:hover {
    border-color: rgba(var(--cyan-rgb), 0.45);
  }
  .fact--link:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .fact--link {
      transition: border-color 150ms ease-out;
    }
    .fact--link:active {
      transform: none;
    }
  }
  @media (prefers-contrast: more) {
    .fact__rest {
      color: var(--ink);
    }
    .fact__index {
      color: var(--ink-2);
    }
  }
</style>
