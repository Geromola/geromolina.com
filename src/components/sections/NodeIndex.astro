---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const nodes = (await getCollection('nodes')).map((e) => e.data).sort((a, b) => a.order - b.order);
---

<Section id="node-index" kicker="INDEX · THE GRID" title="Every node on the grid">
  <ul class="index" role="list">
    {
      nodes.map((n) => (
        <li>
          <a class={`row row--${n.kind}`} href={n.href}>
            <span class="row__kicker mono">{n.kicker}</span>
            <span class="row__title">{n.title}</span>
            {n.locked && (
              <svg class="row__lock" aria-label="locked" role="img" viewBox="0 0 16 16" width="14" height="14">
                <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
              </svg>
            )}
            <span class="row__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .index li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .row {
    display: grid;
    grid-template-columns: 11rem 1fr auto auto;
    align-items: center;
    gap: 1rem;
    min-height: 44px;
    padding: 0.75rem 0.75rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 150ms ease-out;
  }
  .row:hover {
    background: rgba(255, 255, 255, 0.03);
  }
  .row__kicker {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .row--plant .row__kicker {
    color: var(--cyan);
  }
  .row--substation .row__kicker,
  .row__lock {
    color: var(--amber);
  }
  .row__title {
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }
  .row__lock {
    grid-column: 3;
  }
  .row__arrow {
    grid-column: 4;
    color: var(--muted);
    transition: color 150ms ease-out;
  }
  .row:hover .row__arrow {
    color: var(--ink);
  }
  @media (max-width: 540px) {
    .row {
      grid-template-columns: 1fr auto auto;
      row-gap: 0.125rem;
    }
    .row__kicker {
      grid-column: 1;
    }
    .row__title {
      grid-column: 1;
      grid-row: 2;
    }
    .row__lock {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .row__arrow {
      grid-column: 3;
      grid-row: 1 / 3;
    }
  }
  @media (prefers-contrast: more) {
    .index,
    .index li {
      border-color: rgba(255, 255, 255, 0.4);
    }
    .row__kicker,
    .row__arrow {
      color: var(--ink-2);
    }
  }
</style>
