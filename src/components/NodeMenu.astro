---
// Home hero v4 (SPEC "Home hero v3: the node menu", "Home hero v4"): the root node "Gero"
// (top-left) powers its links (About, Off the grid, Contact: small nodes beside it) and two fenced
// sections on the lattice, NEWS WIRE (today's top stories, from the latest `news` edition) and
// PROJECTS. Each section has a switch node (a button) that expands and collapses it like a
// dropdown on the grid. Every child is a glyph plus a glass plate, fused into one link.
// `src/grid/menu.ts` lays everything out on lattice vertices (`menuLayout` in
// src/grid/game/decor.ts), runs the power-on intro and the decorative flow (root → link,
// root → switch → child, along lit corridors), and animates the sections.
//
// PROJECTS by category (SPEC "Projects menu by category"): Math & Nature, Games, Solutions, from
// each node's `category` in the collection. A header per category on the trunk, its cards under
// it; a category shows its first few cards and a "Show more" button reveals the rest.
//
// Without JS the menu is a plain stacked list (the switches do nothing and everything is shown).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gero from '../assets/gero.jpg';
import { groupByCategory } from '../grid/categories';
import { ageLabel, allEntries, headline, sortEditions } from '../news/edition';

type Kind = 'plant' | 'substation' | 'section';
type Badge = 'live' | 'code' | 'private' | 'play' | 'soon' | null;

interface Entry {
  id: string;
  kind: Kind | 'game' | 'soon' | 'news' | 'wire';
  badge: Badge;
  title: string;
  /** The one short line under the title: a metric (mono value + label) or a phrase. */
  value?: string;
  label: string;
  /** A shorter phrase for the compact (phone) plate, where the label would truncate. */
  short?: string;
  /** No href: not a link yet (rendered disabled). */
  href?: string;
  /** A live plant: it feeds the flow. */
  source: boolean;
  /** How far its ring fills once powered (1 unless under construction). */
  fill?: number;
  /** Small chips on the plate (`var(--mono)`). */
  tags: string[];
  /** A news wire story: its edition id, outlet, when it was published, and whether it's a live blog. */
  story?: { id: string; source: string; publishedAt: string; age: string; live: boolean };
}

const all = (await getCollection('nodes')).map((e) => e.data).sort((a, b) => a.order - b.order);
const byId = new Map(all.map((n) => [n.id, n]));
const pick = (ids: string[]) => ids.flatMap((id) => (byId.has(id) ? [byId.get(id)!] : []));

// The tracker has no metric in the collection.
const TRACKER_LINE = 'Private · sign-in';

// Short map lines that fit the plate without an ellipsis (the full metrics live on the project
// pages); games have no metrics, so their line lives here too, with a shorter phone phrase.
const SHORT: Record<string, { value: string; label: string; short?: string }> = {
  'spotify-insight': { value: '660,622', label: 'reviews' },
  'custom-llm': { value: '122K', label: 'parameters' },
  'personal-wiki': { value: '100%', label: 'offline' },
  'pacman-dqn': { value: '3.4×', label: 'baseline score' },
  ballpark: { value: '11', label: 'decades of energy', short: 'decades' },
  shells: { value: '3', label: 'numbers, every shell', short: 'numbers' },
  life: { value: '1', label: 'rule, a whole universe', short: 'rule' },
};

const toEntry = (n: (typeof all)[number]): Entry => ({
  id: n.id,
  kind: n.kind,
  // Games (Ballpark, Raup's Cube, Conway's Life) are interactive pages: ▶ PLAY.
  badge:
    n.kind === 'section'
      ? null
      : n.kind === 'game'
        ? 'play'
        : n.status === 'live'
          ? 'live'
          : n.status === 'private'
            ? 'private'
            : 'code',
  title: n.title,
  value: SHORT[n.id]?.value ?? n.metrics?.[0]?.value,
  label: SHORT[n.id]?.label ?? n.metrics?.[0]?.label ?? (n.kind === 'substation' ? TRACKER_LINE : n.kicker),
  short: SHORT[n.id]?.short,
  href: n.href,
  source: n.kind === 'plant' && n.status === 'live',
  tags: n.tags,
});

// PROJECTS: every plant, substation and game, by category, each by `order` within it. A new node
// file with a category lands in its row with no code change; empty categories aren't rendered.
const categories = groupByCategory(all.filter((n) => n.kind !== 'section')).map((g) => ({
  ...g,
  entries: g.items.map(toEntry),
}));
const projects = categories.flatMap((c) => c.entries);

// The root's links: the page sections, as small nodes beside the root.
const ABOUT = ['about', 'off-the-grid', 'contact'];
const links = [...pick(ABOUT), ...all.filter((n) => n.kind === 'section' && !ABOUT.includes(n.id))];

// NEWS WIRE: the latest edition by category, Must know first (SPEC "Home hero v4"). The grid
// shows the featured category's top stories and an All-stories control; the full wire shows
// every story across the page. A story opens its panel here (`src/news/sheet.ts`), or its card
// on /news without JS. Rebuilt with every edition (the daily commit redeploys).
const TOP_STORIES = 3;
const latest = sortEditions((await getCollection('news')).map((e) => e.data))[0];
const storyCount = latest ? allEntries(latest).length : 0;
const NEWS_CATS: { id: string; label: string; tagline: string; list: (e: NonNullable<typeof latest>) => Entry_[] }[] = [
  { id: 'must', label: 'Must know', tagline: 'What everyone will be talking about.', list: (e) => e.mustKnow },
  { id: 'cleantech', label: 'Clean tech', tagline: 'Energy, grid, storage, climate.', list: (e) => e.sections.cleantech },
  { id: 'ai', label: 'AI', tagline: 'Models, research, the business of it.', list: (e) => e.sections.ai },
  { id: 'world', label: 'World', tagline: 'Global, the US, Mexico.', list: (e) => e.sections.world },
];
type Entry_ = ReturnType<typeof allEntries>[number];
const storyEntry = (e: Entry_): Entry => {
  const h = headline(e.title);
  return {
    id: `news-${e.id}`,
    kind: 'news',
    badge: null,
    title: h.text,
    label: e.source,
    href: `/news#s-${e.id}`,
    source: false,
    tags: [],
    // "New York Times", not "The New York Times": the plate's meta line is short.
    story: {
      id: e.id,
      source: e.source.replace(/^The\s+/i, ''),
      publishedAt: e.publishedAt,
      age: ageLabel(e.publishedAt, latest!.generatedAt),
      live: h.live,
    },
  };
};
const newsCats = latest
  ? NEWS_CATS.map((c) => ({ id: `news-${c.id}`, label: c.label, tagline: c.tagline, entries: c.list(latest).map(storyEntry) })).filter(
      (c) => c.entries.length > 0,
    )
  : [];
// Every story, for the panels, in the order the wire shows them.
const stories = latest ? NEWS_CATS.flatMap((c) => c.list(latest).map((e) => ({ ...e, sectionLabel: c.label }))) : [];
// No edition yet: one node that says so.
const newsEmpty: Entry[] = [
  { id: 'news-wire', kind: 'wire', badge: null, title: 'News wire', label: 'First edition soon', href: '/news', source: false, tags: [] },
];

// The two sections, in DOM (and tab) order: NEWS WIRE is one plain block, PROJECTS a block per
// category. Child indices (`data-menu-node`) run across everything.
interface Block {
  cat: { id: string; label: string; tagline: string } | null;
  entries: (Entry & { index: number })[];
}
let index = 0;
const block = (cat: Block['cat'], entries: Entry[]): Block => ({ cat, entries: entries.map((e) => ({ ...e, index: index++ })) });
const groups = [
  {
    key: 'news',
    label: 'News wire',
    count: `${storyCount} stories`,
    blocks: newsCats.length ? newsCats.map(({ id, label, tagline, entries }) => block({ id, label, tagline }, entries)) : [block(null, newsEmpty)],
  },
  {
    key: 'projects',
    label: 'Projects',
    count: `${projects.length} projects`,
    blocks: categories.map(({ id, label, tagline, entries }) => block({ id, label, tagline }, entries)),
  },
];
// Phones and tablets show this many cards per category until "Show more" (menu.ts sets the real
// count per width; this is the markup's starting label).
const SHOWN = 2;

// A circle and a rounded square as paths (start at the top, clockwise), so `pathLength` works everywhere.
const RING = 'M50 4 a46 46 0 1 1 0 92 a46 46 0 1 1 0 -92';
const SQUARE = 'M50 4 H74 a22 22 0 0 1 22 22 V74 a22 22 0 0 1 -22 22 H26 a22 22 0 0 1 -22 -22 V26 a22 22 0 0 1 22 -22 Z';
---

<div class="nmenu" data-menu>
  <script is:inline>
    // menu.ts lays the menu out on the lattice: hide it until then (no jump from the fallback
    // layout). Power-on intro: nodes start dark, before the first paint; skipped under reduced
    // motion and on a quick return from a project page (the view transition collapses into a lit
    // node). If the client entry never runs, the plain layout shows and everything lights.
    (() => {
      const root = document.currentScript.parentElement;
      const html = document.documentElement;
      root.dataset.js = '';
      setTimeout(() => {
        if ('laid' in root.dataset) return;
        delete root.dataset.js;
        delete root.dataset.intro;
      }, 3000);
      if (html.dataset.motion === 'reduce' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        const r = JSON.parse(sessionStorage.getItem('gero-vt') || 'null');
        if (r && typeof r.t === 'number' && Date.now() - r.t < 30000) return;
      } catch {
        /* storage unavailable: play the intro */
      }
      root.dataset.intro = '';
    })();
  </script>

  <div class="nmenu__map" aria-hidden="true">
    <canvas class="nmenu__layer" data-mesh></canvas>
    <canvas class="nmenu__layer" data-corridors></canvas>
    <canvas class="nmenu__layer" data-electrons></canvas>
  </div>
  <!-- Outside the map: the map keeps the full menu height while a collapsed section shortens the menu. -->
  <div class="nmenu__vignette" aria-hidden="true"></div>

  <div class="nmenu__content" data-content>
    <!-- The root node: the power source. Not a link; the page's h1. -->
    <header class="mroot" data-root>
      <span class="mroot__glyph" data-root-glyph aria-hidden="true">
        <svg class="mnode__ring" viewBox="0 0 100 100">
          <path class="mnode__ring-base" d={RING} pathLength="100" />
          <path class="mnode__ring-fill" d={RING} pathLength="100" data-ring />
        </svg>
        <span class="mnode__charge"></span>
        <span class="mroot__photo">
          <Image src={gero} width={132} widths={[66, 132, 198]} sizes="66px" alt="" loading="eager" decoding="async" />
        </span>
      </span>
      <span class="mroot__plate glass" data-root-plate>
        <p class="mroot__kicker mono">Geronimo Molina</p>
        <h1 class="mroot__name">Gero</h1>
        <p class="mroot__line">
          <span class="mroot__part">MBA + MEng Candidate</span><span class="mroot__sep">&nbsp;· </span><span
            class="mroot__part">UC Berkeley, California</span>
        </p>
      </span>
    </header>

    <!-- The root's links: small nodes beside it (below it on phones), fed straight from the root. -->
    <nav class="mlinks" aria-label="About me">
      {
        links.map((n) => (
          <a class="mlink" href={n.href} data-link data-id={n.id}>
            <span class="mlink__glyph" data-link-glyph aria-hidden="true">
              <svg class="mnode__ring" viewBox="0 0 100 100">
                <path class="mnode__ring-base" d={RING} pathLength="100" />
                <path class="mnode__ring-fill" d={RING} pathLength="100" data-ring />
              </svg>
              <span class="mnode__charge" />
              <span class="mswitch__core" />
            </span>
            <span class="mlink__label">{n.title}</span>
          </a>
        ))
      }
    </nav>

    <nav class="nmenu__sections" id="menu-nodes" aria-label="News and projects">
      {
        groups.map((group) => (
          <section class={`msec msec--${group.key}`} data-section={group.key} aria-labelledby={`msec-${group.key}-switch`}>
            <div class="mfence" data-fence aria-hidden="true">
              <span class="mfence__label mono">{group.label}</span>
            </div>
            <button
              class="mswitch"
              type="button"
              id={`msec-${group.key}-switch`}
              data-switch
              aria-expanded="true"
              aria-controls={`msec-${group.key}`}>
              <span class="mswitch__glyph" data-switch-glyph aria-hidden="true">
                <svg class="mnode__ring" viewBox="0 0 100 100">
                  <path class="mnode__ring-base" d={RING} pathLength="100" />
                  <path class="mnode__ring-fill" d={RING} pathLength="100" data-ring />
                </svg>
                <span class="mnode__charge" />
                <span class="mswitch__core" />
              </span>
              <span class="mswitch__label">{group.label}</span>
              <span class="mswitch__chev" aria-hidden="true">
                ▾
              </span>
              <span class="mswitch__count mono" aria-hidden="true">
                {group.count}
              </span>
            </button>
            {group.key === 'news' && newsCats.length > 0 && (
              <button class="mback" type="button" data-news-back hidden>
                <span aria-hidden="true">←</span> Back to the grid
              </button>
            )}
            <div class="msec__list" id={`msec-${group.key}`} data-list>
              {group.blocks.map(({ cat, entries }) => (
                <div
                  class:list={['mcat', !cat && 'mcat--plain']}
                  data-cat={cat?.id}
                  role={cat ? 'group' : undefined}
                  aria-labelledby={cat ? `mcat-${cat.id}` : undefined}>
                  {cat && (
                    <div class="mcat__head" data-cat-head data-id={`cat-${cat.id}`}>
                      <span class="mcat__glyph" data-cat-glyph aria-hidden="true">
                        <svg class="mnode__ring" viewBox="0 0 100 100">
                          <path class="mnode__ring-base" d={RING} pathLength="100" />
                          <path class="mnode__ring-fill" d={RING} pathLength="100" data-ring />
                        </svg>
                        <span class="mnode__charge" />
                        <span class="mswitch__core" />
                      </span>
                      <span class="mcat__text">
                        <span class="mcat__title">
                          <span class="mcat__label" id={`mcat-${cat.id}`}>
                            {cat.label}
                          </span>
                          <span class="mcat__count mono" aria-hidden="true">
                            {entries.length}
                          </span>
                        </span>
                        <span class="mcat__tagline">{cat.tagline}</span>
                      </span>
                    </div>
                  )}
                  <ul
                    class="mcat__list"
                    id={cat ? `mcat-${cat.id}-list` : undefined}
                    role="list"
                    data-cat-list={cat ? '' : undefined}>
                    {entries.map((n) => (
                <li class="mitem" data-menu-item>
                  <a
                    class:list={['mnode', `mnode--${n.kind}`, n.badge && `mnode--${n.badge}`]}
                    href={n.href}
                    role={n.href ? undefined : 'link'}
                    aria-disabled={n.href ? undefined : 'true'}
                    tabindex={n.href ? undefined : -1}
                    data-menu-node={n.index}
                    data-id={n.id}
                    data-story={n.story?.id}
                    data-soon={n.href ? undefined : ''}
                    data-fill={n.fill === undefined ? undefined : String(n.fill)}>
                    <span class="mnode__glyph" data-menu-glyph aria-hidden="true">
                      <svg class="mnode__ring" viewBox="0 0 100 100">
                        <path class="mnode__ring-base" d={n.kind === 'substation' ? SQUARE : RING} pathLength="100" />
                        <path class="mnode__ring-fill" d={n.kind === 'substation' ? SQUARE : RING} pathLength="100" data-ring />
                      </svg>
                      <span class="mnode__charge" />
                      {(n.kind === 'plant' || n.kind === 'section' || n.kind === 'game' || n.kind === 'news' || n.kind === 'wire') && <span class="mnode__core" />}
                      {n.kind === 'substation' && (
                        <svg class="mnode__lock" viewBox="0 0 16 16">
                          <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>
                      )}
                    </span>
                    <span class="mnode__plate glass">
                      {n.story && (
                        <>
                          <span class="mnode__meta mono">
                            <span class="mnode__source">{n.story.source}</span>
                            {n.story.live && <span class="mnode__live">Live</span>}
                            <time datetime={n.story.publishedAt} data-age>
                              {n.story.age}
                            </time>
                          </span>
                          <span class="mnode__headline">{n.title}</span>
                        </>
                      )}
                      {n.badge && (
                        <span class="mnode__badge mono">
                          {n.badge === 'live' ? (
                            <>
                              <span aria-hidden="true">●</span> Live
                            </>
                          ) : n.badge === 'private' ? (
                            <>
                              <svg class="mnode__badge-lock" viewBox="0 0 16 16" aria-hidden="true">
                                <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                                <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
                              </svg>{' '}
                              Mine
                            </>
                          ) : n.badge === 'play' ? (
                            <>
                              <span aria-hidden="true">▶</span> Play
                            </>
                          ) : n.badge === 'soon' ? (
                            <>
                              <span aria-hidden="true">◌</span> Soon
                            </>
                          ) : (
                            <>
                              <span aria-hidden="true">‹/›</span> Code
                            </>
                          )}
                        </span>
                      )}
                      {!n.story && <span class="mnode__title">{n.title}</span>}
                      {!n.story && <span class="mnode__line mono">
                        {n.value && <span class="mnode__value">{n.value}</span>}{' '}
                        {n.short ? (
                          <>
                            <span class="mnode__full">{n.label}</span>
                            <span class="mnode__short">{n.short}</span>
                          </>
                        ) : (
                          n.label
                        )}
                      </span>}
                      {n.tags.length > 0 && (
                        <span class="mnode__tags">
                          {n.tags.map((t) => (
                            <span class="mnode__tag mono">{t}</span>
                          ))}
                        </span>
                      )}
                      {!n.href && (
                        <span class="mnode__hint mono" aria-hidden="true">
                          Coming soon
                        </span>
                      )}
                    </span>
                  </a>
                </li>
                    ))}
                  </ul>
                  {group.key === 'news' && cat && cat.id === newsCats[0]?.id && (
                    <button class="mcat__more mcat__more--all" type="button" data-cat-more data-news-all hidden>
                      <span>All {storyCount} stories</span>
                      <span class="mcat__chev" aria-hidden="true">
                        →
                      </span>
                    </button>
                  )}
                  {group.key !== 'news' && cat && entries.length > SHOWN && (
                    <button
                      class="mcat__more"
                      type="button"
                      data-cat-more
                      aria-expanded="false"
                      aria-controls={`mcat-${cat.id}-list`}
                      hidden>
                      <span data-more-label>Show {entries.length - SHOWN} more</span>
                      <span class="mcat__chev" aria-hidden="true">
                        ▾
                      </span>
                    </button>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </nav>
  </div>
</div>

<!-- A story's panel (src/news/sheet.ts): its brief, why it matters, and the way out to the outlet. -->
<aside class="nsheet glass" data-sheet role="dialog" aria-labelledby="nsheet-title" hidden>
  <button class="nsheet__close" type="button" data-sheet-close aria-label="Close">
    <span aria-hidden="true">×</span>
  </button>
  <div class="nsheet__body" data-sheet-body></div>
</aside>
{
  stories.map((e) => {
    const h = headline(e.title);
    return (
      <template data-story-tpl={e.id}>
        <p class="nsheet__meta mono">
          <span>{e.sectionLabel}</span>
          <span aria-hidden="true">·</span>
          <span>{e.source}</span>
          {h.live && <span class="nsheet__live">Live</span>}
          {e.lang === 'es' && <span class="nsheet__chip">ES</span>}
          <time datetime={e.publishedAt} data-age>
            {ageLabel(e.publishedAt, latest!.generatedAt)}
          </time>
        </p>
        <h2 class="nsheet__title" id="nsheet-title" tabindex="-1">
          {h.text}
        </h2>
        {e.brief ? <p class="nsheet__brief">{e.brief}</p> : e.snippet && <p class="nsheet__brief">{e.snippet}</p>}
        {e.why && (
          <p class="nsheet__why">
            <span class="mono">Why</span> {e.why}
          </p>
        )}
        {e.originalTitle && (
          <p class="nsheet__original" lang="es">
            {e.originalTitle}
          </p>
        )}
        {e.alsoCovered.length > 0 && (
          <p class="nsheet__also">
            Also in{' '}
            {e.alsoCovered.map((o, k) => (
              <>
                {k > 0 && ' · '}
                <a href={o.url} target="_blank" rel="noopener noreferrer">
                  {o.source}
                </a>
              </>
            ))}
          </p>
        )}
        <p class="nsheet__actions">
          <a class="nsheet__open" href={e.url} target="_blank" rel="noopener noreferrer">
            Read on {e.source} <span aria-hidden="true">↗</span>
          </a>
          <a class="nsheet__wire" href={`/news#s-${e.id}`}>
            On the wire
          </a>
        </p>
      </template>
    );
  })
}

<script>
  import { mountMenu } from '../grid/menu';
  import { ageLabel } from '../news/edition';
  import { mountStorySheet } from '../news/sheet';
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) {
    // The page was built with the edition: show each story's age against the viewer's clock.
    const now = new Date();
    for (const t of root.querySelectorAll<HTMLTimeElement>('time[data-age]')) t.textContent = ageLabel(t.dateTime, now);
    mountMenu(root);
    mountStorySheet(root);
  }
</script>

<style>
  .nmenu {
    position: relative;
    min-height: max(560px, 100svh);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- the grid behind (menu.ts) ---------- */
  .nmenu__map {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(120% 80% at 30% 20%, var(--bg-raise) 0%, var(--bg) 62%);
  }
  .nmenu__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .nmenu__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(130% 100% at 45% 35%, transparent 55%, rgba(4, 7, 11, 0.85) 100%),
      linear-gradient(to bottom, transparent 85%, var(--bg) 100%);
  }

  /* ---------- fallback layout (no JS yet, or none at all): a plain stacked list ---------- */
  .nmenu__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 4.5rem var(--gutter) 4rem;
  }
  .nmenu[data-js]:not([data-laid]) .nmenu__content {
    visibility: hidden;
  }
  .nmenu__sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .msec {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .msec__list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .mcat {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .mcat__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 2.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mfence {
    display: none;
  }

  /* ---------- lattice layout (menu.ts): everything absolutely placed on vertices ---------- */
  .nmenu[data-laid] .nmenu__content {
    display: block;
    padding: 0;
  }
  /* The wrappers keep their semantics but stop taking part in layout: full-size, click-through layers. */
  .nmenu[data-laid] :is(.mlinks, .nmenu__sections, .msec, .msec__list, .mcat, .mcat__list) {
    display: block;
    position: absolute;
    inset: 0;
    margin: 0;
    pointer-events: none;
  }
  .nmenu[data-laid] :is(.mroot, .mlink, .mswitch, .mitem, .mfence, .mcat__head, .mcat__more) {
    position: absolute;
  }
  .nmenu[data-laid] :is(.mlink, .mswitch, .mitem, .mcat__head, .mcat__more) {
    pointer-events: auto;
  }
  .nmenu[data-laid] .mfence {
    display: block;
  }

  /* ---------- the root node ---------- */
  .mroot {
    --power: 1;
    --charge: 0;
    --pulse: 0;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .nmenu[data-laid] .mroot {
    translate: 0 -50%;
  }
  /* MENU_PX.rootGlyph (80px). */
  .mroot__glyph {
    --glyph: 80px;
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow:
      0 0 calc(6px + var(--power) * 26px) rgba(var(--cyan-rgb), calc(0.1 + var(--power) * 0.45)),
      0 0 calc(var(--power) * 60px) rgba(var(--cyan-rgb), calc(var(--power) * 0.18));
  }
  .mroot__photo {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    overflow: hidden;
    opacity: calc(0.35 + var(--power) * 0.65);
  }
  .mroot__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
    /* The duotone filter is defined once, in About.astro (later in the page). */
    filter: url(#gero-duotone);
  }
  .mroot .mnode__ring path {
    stroke-width: 2;
  }
  .mroot .mnode__ring-fill {
    stroke: var(--hot);
    filter: drop-shadow(0 0 calc(2px + var(--power) * 5px) rgba(var(--cyan-rgb), 0.9));
  }
  .mroot__plate {
    display: flex;
    flex-direction: column;
    padding: 0.625rem 1.125rem 0.6875rem;
    border-radius: var(--radius-md);
  }
  .mroot__kicker {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .mroot__name {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    /* Same gradient as v2's header (ProjectMenu.astro). */
    background: linear-gradient(180deg, #fff 30%, #9fdcec 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mroot__line {
    margin: 0.1875rem 0 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
  /* Phones: two clean lines, no separator dot left hanging. */
  @media (max-width: 767px) {
    .mroot__plate {
      padding: 0.375rem 0.875rem 0.4375rem;
    }
    .mroot__name {
      font-size: 1.875rem;
    }
    .mroot__line {
      font-size: 0.8125rem;
    }
    .mroot__line {
      line-height: 1.3;
    }
    .mroot__part {
      display: block;
    }
    .mroot__sep {
      display: none;
    }
  }

  /* ---------- the root's links: small nodes beside the root, or in a row under it ---------- */
  .mlinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .mlink {
    --power: 1;
    --pulse: 0;
    --glow: 0;
    --charge: 0;
    --lift: 0;
    --press: 1;
    --shown: 1;
    --fx: 0px;
    --fy: 0px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .nmenu[data-laid] .mlink {
    width: var(--item-w);
    opacity: var(--shown);
    transform: translate(calc((1 - var(--shown)) * var(--fx)), calc((1 - var(--shown)) * var(--fy) + var(--lift) * 1px))
      scale(calc(var(--press) * (0.72 + 0.28 * var(--shown))));
    transform-origin: 15px 50%;
  }
  /* Beside the root: MENU_PX.compactH (40px) tall, the glyph on the vertex, a one-line plate
     that fills its slot, so the row runs out to the right edge. */
  .nmenu[data-links='compact'] .mlink {
    height: 2.5rem;
  }
  .nmenu[data-links='compact'] .mlink__label {
    flex: 1 1 auto;
  }
  .mlink__glyph {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 calc(3px + var(--power) * 6px + var(--pulse) * 16px)
      rgba(var(--cyan-rgb), calc(var(--power) * 0.3 + var(--pulse) * 0.4 + var(--glow) * 0.15));
    transform: scale(calc(1 + var(--pulse) * 0.12));
  }
  .mlink .mnode__charge {
    inset: -3px;
    border-width: 1.5px;
  }
  .mlink__label {
    flex: 0 1 auto;
    display: flex;
    align-items: center;
    min-width: 0;
    height: 2.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--glass-border);
    border-top-color: var(--glass-edge);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-raise) 72%, transparent);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    font-size: 0.875rem;
    font-weight: 550;
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      border-color 150ms ease-out,
      color 150ms ease-out;
  }
  /* Phones: the label under the glyph, on a dark backing so corridors don't cross the text. */
  .nmenu[data-links='stack'] .mlink {
    flex-direction: column;
    gap: 0.25rem;
    transform-origin: 50% 15px;
  }
  .nmenu[data-links='stack'] .mlink__label {
    height: auto;
    padding: 0.0625rem 0.375rem;
    border: 0;
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    font-size: 0.8125rem;
    line-height: 1.15;
    text-align: center;
    /* The narrowest phones give a label one spacing: "Off the grid" wraps rather than cuts. */
    white-space: normal;
  }
  .mlink.is-hot .mlink__label {
    border-color: rgba(var(--cyan-rgb), 0.45);
    color: var(--hot);
  }
  .mlink:focus-visible {
    outline: none;
  }
  .mlink:focus-visible .mlink__label {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  /* ---------- fences: a thin dashed outline on lattice lines, the label on the line ---------- */
  .mfence {
    border: 1px dashed rgba(var(--cyan-rgb), 0.32);
    border-radius: 12px;
    pointer-events: none;
  }
  .mfence__label {
    position: absolute;
    top: 0;
    left: 0.875rem;
    translate: 0 -50%;
    padding: 0 0.375rem;
    background: var(--bg);
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .msec--projects .mfence__label {
    color: var(--cyan);
  }

  /* ---------- section switch: a glyph and a label, a real button ---------- */
  .mswitch {
    --power: 1;
    --charge: 0;
    --pulse: 0;
    --glow: 0;
    --chev: 0;
    --open: 1;
    --press: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    /* MENU_PX.switchGlyph (56px): a heading outranks the nodes it holds. */
    height: 3.5rem;
    margin: 0;
    padding: 0 0.75rem 0 0;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform: scale(var(--press));
    transform-origin: 28px 50%;
  }
  .nmenu[data-laid] .mswitch {
    translate: 0 -50%;
  }
  .mswitch:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  :is(.mswitch__glyph, .mcat__glyph) {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    /* MENU_PX.switchGlyph (56px); a category header's is MENU_PX.headerGlyph (46px). */
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--cyan-rgb), calc(0.05 + var(--power) * 0.2)) 0%, var(--bg) 72%);
    box-shadow:
      0 0 calc(6px + var(--power) * 14px + var(--pulse) * 24px)
        rgba(var(--cyan-rgb), calc(var(--power) * 0.42 + var(--pulse) * 0.4 + var(--glow) * 0.2)),
      0 0 calc(var(--power) * 40px) rgba(var(--cyan-rgb), calc(var(--power) * 0.14));
    transform: scale(calc(1 + var(--pulse) * 0.1));
  }
  .mcat__glyph {
    width: 46px;
    height: 46px;
  }
  :is(.mswitch, .mcat__head) .mnode__ring path {
    stroke-width: 2;
  }
  .mswitch__core {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 14px 3px rgba(var(--cyan-rgb), 0.85);
    opacity: calc(0.15 + var(--power) * 0.85);
  }
  .mcat__glyph .mswitch__core {
    width: 12px;
    height: 12px;
    box-shadow: 0 0 11px 2px rgba(var(--cyan-rgb), 0.8);
  }
  .mswitch__label {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .mswitch__chev {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--ink-2);
    rotate: calc(var(--chev) * -90deg);
  }
  .mswitch__count {
    font-size: 0.75rem;
    color: var(--muted);
    opacity: calc(1 - var(--open));
  }
  @media (hover: hover) {
    .mswitch:hover .mswitch__label {
      color: var(--hot);
    }
  }

  /* ---------- category header: a small glyph on the trunk, the label, a count and the tagline ---------- */
  .mcat__head {
    --power: 1;
    --charge: 0;
    --pulse: 0;
    --glow: 0;
    --press: 1;
    --shown: 1;
    --fx: 0px;
    --fy: 0px;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
  }
  .nmenu[data-laid] .mcat__head {
    max-width: var(--head-w);
    translate: 0 -50%;
    opacity: var(--shown);
    transform: translate(calc((1 - var(--shown)) * var(--fx)), calc((1 - var(--shown)) * var(--fy)));
  }
  .mcat__head .mnode__charge {
    inset: -4px;
    border-width: 2px;
  }
  /* A dark backing, like the fence labels', so corridors and electrons don't run through the text. */
  .mcat__text {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    min-width: 0;
    margin-left: -0.25rem;
    padding: 0.125rem 0.5rem 0.125rem 0.25rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
  }
  .mcat__title {
    flex: none;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4375rem;
  }
  .mcat__label {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }
  .mcat__count {
    font-size: 0.75rem;
    color: var(--cyan);
  }
  .mcat__tagline {
    min-width: 0;
    font-size: 0.8125rem;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink-2);
  }
  /* Phones: the tagline under the label, wrapping. */
  .nmenu[data-mode='column'] .mcat__text {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.0625rem;
  }
  .nmenu[data-mode='column'] .mcat__tagline {
    font-size: 0.75rem;
    white-space: normal;
  }
  .mcat__head.is-hot .mcat__label {
    color: var(--hot);
  }

  /* ---------- Show more / Show less: a real button under the category's last row ---------- */
  .mcat__more {
    --shown: 1;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    margin: 0;
    padding: 0 0.875rem;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-raise) 86%, transparent);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 150ms ease-out,
      color 150ms ease-out;
  }
  /* A 44px target on touch, without growing the pill. */
  .mcat__more::before {
    content: '';
    position: absolute;
    inset: -6px -4px;
  }
  .mcat__more[hidden],
  .nmenu:not([data-laid]) .mcat__more {
    display: none;
  }
  .nmenu[data-laid] .mcat__more {
    opacity: var(--shown);
  }
  .mcat__more[data-align='end'] {
    translate: -100% 0;
  }
  .mcat__chev {
    font-size: 0.6875rem;
    color: var(--ink-2);
  }
  .mcat__more[aria-expanded='true'] .mcat__chev {
    rotate: 180deg;
  }
  .mcat__more:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  /* NEWS WIRE's All-stories control: it opens the full wire. */
  .mcat__more--all {
    height: 2.25rem;
    padding: 0 1rem;
    border-color: rgba(var(--cyan-rgb), 0.45);
    background: color-mix(in srgb, var(--bg-raise) 80%, rgba(var(--cyan-rgb), 0.2));
    font-weight: 600;
  }
  .mcat__more--all .mcat__chev {
    font-size: 0.8125rem;
    color: var(--cyan);
  }

  /* The full wire's way back: on NEWS WIRE's fence, top right (menu.ts places it). */
  .mback {
    --open: 1;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    margin: 0;
    padding: 0 0.875rem;
    border: 1px solid rgba(var(--cyan-rgb), 0.45);
    border-radius: 999px;
    background: var(--bg-raise);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 150ms ease-out,
      color 150ms ease-out;
  }
  .mback::before {
    content: '';
    position: absolute;
    inset: -6px -4px;
  }
  .mback[hidden],
  .nmenu:not([data-laid]) .mback {
    display: none;
  }
  .nmenu[data-laid] .mback {
    position: absolute;
    translate: -100% -50%;
    opacity: var(--open);
    pointer-events: auto;
  }
  .mback:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .mback:hover {
      border-color: var(--cyan);
      color: var(--hot);
    }
  }
  @media (hover: hover) {
    .mcat__more:hover {
      border-color: rgba(var(--cyan-rgb), 0.5);
      color: var(--hot);
    }
  }

  /* ---------- children: one node object, plates hanging (projects, desktop) or beside ---------- */
  .mitem {
    --shown: 1;
    --fx: 0px;
    --fy: 0px;
    display: flex;
  }
  .nmenu[data-laid] .mitem {
    width: var(--item-w);
    opacity: var(--shown);
    transform: translate(calc((1 - var(--shown)) * var(--fx)), calc((1 - var(--shown)) * var(--fy)))
      scale(calc(0.72 + 0.28 * var(--shown)));
  }
  .mnode {
    --glyph: 44px;
    --power: 1;
    --pulse: 0;
    --glow: 0;
    --charge: 0;
    --lift: 0;
    --press: 1;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transform: translateY(calc(var(--lift) * 1px)) scale(var(--press));
  }
  .mnode[href] {
    cursor: pointer;
  }
  .nmenu[data-intro] :is(.mnode, .mlink, .mswitch, .mroot, .mcat__head) {
    --power: 0;
  }

  /* Glyph: the plant, substation or section ring. Its ring fills and lights as power arrives. */
  .mnode__glyph {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--glyph);
    height: var(--glyph);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--cyan-rgb), calc(0.04 + var(--power) * 0.16)) 0%, var(--bg) 70%);
    box-shadow: 0 0 calc(4px + var(--power) * 6px + var(--pulse) * 22px)
      rgba(var(--cyan-rgb), calc(var(--power) * 0.22 + var(--pulse) * 0.45 + var(--glow) * 0.12));
    transform: scale(calc(1 + var(--pulse) * 0.1));
  }
  .mnode--substation .mnode__glyph {
    border-radius: 28%;
    color: var(--amber);
    background: var(--bg);
    box-shadow: 0 0 calc(4px + var(--power) * 6px + var(--pulse) * 18px)
      rgba(var(--amber-rgb), calc(var(--power) * 0.25 + var(--pulse) * 0.45 + var(--glow) * 0.12));
  }
  .mnode__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .mnode__ring path {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mnode__ring-base {
    stroke: rgba(232, 241, 245, 0.22);
  }
  .mnode__ring-fill {
    stroke: var(--cyan);
    stroke-dasharray: 100 0;
    filter: drop-shadow(0 0 calc(1px + var(--power) * 2px + var(--glow) * 4px) rgba(var(--cyan-rgb), 0.7));
  }
  .nmenu[data-intro] .mnode__ring-fill {
    stroke-dasharray: 0 100;
  }
  .mnode--substation .mnode__ring-base {
    stroke: rgba(var(--amber-rgb), 0.3);
  }
  .mnode--substation .mnode__ring-fill {
    stroke: var(--amber);
    filter: drop-shadow(0 0 calc(1px + var(--power) * 2px + var(--glow) * 4px) rgba(var(--amber-rgb), 0.7));
  }
  :is(.mnode, .mlink, .mswitch, .mcat__head).is-hot .mnode__ring-fill {
    stroke: var(--hot);
  }
  .mnode--substation.is-hot .mnode__ring-fill {
    stroke: var(--amber);
  }
  .mnode__core {
    width: calc(var(--glyph) * 0.3);
    height: calc(var(--glyph) * 0.3);
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 calc(var(--glyph) * 0.3) calc(var(--glyph) * 0.06) rgba(var(--cyan-rgb), 0.8);
    opacity: calc(0.12 + var(--power) * 0.88);
  }
  .mnode__lock {
    width: calc(var(--glyph) * 0.42);
    height: calc(var(--glyph) * 0.42);
    opacity: calc(0.35 + var(--power) * 0.65);
  }
  /* Charge sweep: a hot arc swept 0→360° by --charge (menu.ts), on press and at ignition. */
  .mnode__charge {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--hot);
    box-shadow:
      0 0 8px rgba(var(--cyan-rgb), 0.9),
      inset 0 0 6px rgba(var(--cyan-rgb), 0.6);
    pointer-events: none;
    -webkit-mask-image: conic-gradient(black calc(var(--charge) * 1turn), transparent 0);
    mask-image: conic-gradient(black calc(var(--charge) * 1turn), transparent 0);
  }
  .mswitch .mnode__charge {
    inset: -4px;
    border-width: 2px;
  }
  .mnode--substation .mnode__charge {
    border-radius: 32%;
  }

  /* Under construction: a dashed ring that only ever fills halfway. */
  .mnode--soon .mnode__ring-base {
    stroke: var(--muted);
    stroke-dasharray: 4 4;
  }
  .mnode--soon .mnode__ring-fill {
    stroke-dasharray: 50 100;
  }
  .mnode--soon {
    cursor: default;
  }

  /* Plate, hanging style: under the glyph, which overlaps its top edge. One fixed size. */
  .mnode__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    /* MENU_PX.hangH (126px): badge, title, line and a row of tags. */
    height: 7.875rem;
    margin-top: calc(var(--glyph) / -2);
    padding: calc(var(--glyph) / 2 + 0.5rem) 1rem 0.625rem;
    border-radius: var(--radius-md);
    text-align: center;
    transition: border-color 150ms ease-out;
  }
  .mnode--section .mnode__plate {
    justify-content: center;
    padding-bottom: calc(0.625rem + 0.5rem);
  }
  /* Plate, side style: to the right of the glyph (ABOUT ME, and everything on phones). */
  .msec[data-style='side'] .mnode {
