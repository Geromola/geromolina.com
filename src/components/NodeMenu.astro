---
// Home hero v3.2 (SPEC "Home hero v3: the node menu"): the root node "Gero" (top-left) powers two
// fenced sections on the lattice, ABOUT ME and PROJECTS. Each section has a switch node (a
// button) that expands and collapses it like a dropdown on the grid. Every child is a glyph plus a
// glass plate, fused into one link. `src/grid/menu.ts` lays everything out on lattice vertices
// (`menuLayout` in src/grid/game/decor.ts), runs the power-on intro and the decorative flow
// (root → switch → child, along lit corridors), and animates the sections.
//
// Without JS the menu is a plain stacked list (the switches do nothing and everything is shown).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gero from '../assets/gero.jpg';
import SectionNav from './SectionNav.astro';

type Kind = 'plant' | 'substation' | 'section';
type Badge = 'live' | 'code' | 'private' | 'play' | 'soon' | null;

interface Entry {
  id: string;
  kind: Kind | 'game' | 'soon';
  badge: Badge;
  title: string;
  /** The one short line under the title: a metric (mono value + label) or a phrase. */
  value?: string;
  label: string;
  /** A shorter phrase for the compact (phone) plate, where the label would truncate. */
  short?: string;
  /** No href: not a link yet (rendered disabled). */
  href?: string;
  /** A live plant: it feeds the flow. */
  source: boolean;
  /** How far its ring fills once powered (1 unless under construction). */
  fill?: number;
}

// Only these kinds are menu nodes; anything else in the collection (e.g. `kind: game`) is ignored.
const KINDS: readonly string[] = ['plant', 'substation', 'section'];
const all = (await getCollection('nodes'))
  .map((e) => e.data)
  .filter((n): n is typeof n & { kind: Kind } => KINDS.includes(n.kind))
  .sort((a, b) => a.order - b.order);
const byId = new Map(all.map((n) => [n.id, n]));
const pick = (ids: string[]) => ids.flatMap((id) => (byId.has(id) ? [byId.get(id)!] : []));

// The tracker has no metric in the collection.
const TRACKER_LINE = 'Private · sign-in';

// Short map lines that fit the plate without an ellipsis (the full metrics live on the project pages).
const SHORT: Record<string, { value: string; label: string }> = {
  'spotify-insight': { value: '660,622', label: 'reviews' },
  'custom-llm': { value: '122K', label: 'parameters' },
  'personal-wiki': { value: '100%', label: 'offline' },
  'pacman-dqn': { value: '3.4×', label: 'baseline score' },
};

const toEntry = (n: (typeof all)[number]): Entry => ({
  id: n.id,
  kind: n.kind,
  badge: n.kind === 'section' ? null : n.status === 'live' ? 'live' : n.status === 'private' ? 'private' : 'code',
  title: n.title,
  value: SHORT[n.id]?.value ?? n.metrics?.[0]?.value,
  label: SHORT[n.id]?.label ?? n.metrics?.[0]?.label ?? (n.kind === 'substation' ? TRACKER_LINE : n.kicker),
  href: n.href,
  source: n.kind === 'plant' && n.status === 'live',
});

// Ballpark (SPEC "Ballpark"): hardcoded, not from the collection, since it is a game page rather
// than a project page. A PROJECTS node that is a load in the flow, with a ▶ PLAY badge.
const BALLPARK: Entry = {
  id: 'ballpark',
  kind: 'game',
  badge: 'play',
  title: 'Ballpark',
  value: '11',
  label: 'decades of energy',
  short: 'decades',
  href: '/ballpark',
  source: false,
};

// Raup's Cube (SPEC "Raup's Cube"): hardcoded like Ballpark, an interactive page rather than a
// project page. Same ▶ PLAY badge.
const RAUP: Entry = {
  id: 'shells',
  kind: 'game',
  badge: 'play',
  title: "Raup's Cube",
  value: '3',
  label: 'numbers shape a shell',
  short: 'numbers',
  href: '/shells',
  source: false,
};

// Conway's Life (SPEC "Conway's Life"): hardcoded like Ballpark, an interactive page. Same ▶ PLAY badge.
const LIFE: Entry = {
  id: 'life',
  kind: 'game',
  badge: 'play',
  title: "Conway's Life",
  value: '1',
  label: 'rule, a whole universe',
  short: 'rule',
  href: '/life',
  source: false,
};

// PROJECTS, in this order (don't reorder `order` in the content for it); any other plant or
// substation joins at the end.
const LISTED = ['spotify-insight', 'custom-llm', 'personal-wiki', 'pacman-dqn', 'networking-tracker'];
const extraProjects = all.filter((n) => n.kind !== 'section' && !LISTED.includes(n.id));
const projects: Entry[] = [
  ...pick(LISTED.slice(0, 4)).map(toEntry),
  BALLPARK,
  RAUP,
  LIFE,
  ...pick(LISTED.slice(4)).map(toEntry),
  ...extraProjects.map(toEntry),
];

// ABOUT ME: the page sections, each with a short line in place of a metric.
const ABOUT_LINES: Record<string, string> = {
  about: 'Who I am',
  'off-the-grid': 'Muay Thai, cycling, an ACS paper',
  contact: 'Email · LinkedIn · GitHub',
};
// Phone plates have about 16 characters of room.
const ABOUT_SHORT: Record<string, string> = {
  'off-the-grid': 'Muay Thai & more',
  contact: 'Email · LinkedIn',
};
const ABOUT = ['about', 'off-the-grid', 'contact'];
const sections = [...pick(ABOUT), ...all.filter((n) => n.kind === 'section' && !ABOUT.includes(n.id))];
const about: Entry[] = sections.map((n) => ({ ...toEntry(n), label: ABOUT_LINES[n.id] ?? n.title, short: ABOUT_SHORT[n.id] }));

// The two sections, in DOM (and tab) order. Child indices (`data-menu-node`) run across both.
const groups = [
  { key: 'about', label: 'About me', count: `${about.length} nodes`, entries: about, offset: 0 },
  { key: 'projects', label: 'Projects', count: `${projects.length} projects`, entries: projects, offset: about.length },
];

// A circle and a rounded square as paths (start at the top, clockwise), so `pathLength` works everywhere.
const RING = 'M50 4 a46 46 0 1 1 0 92 a46 46 0 1 1 0 -92';
const SQUARE = 'M50 4 H74 a22 22 0 0 1 22 22 V74 a22 22 0 0 1 -22 22 H26 a22 22 0 0 1 -22 -22 V26 a22 22 0 0 1 22 -22 Z';
---

<SectionNav />
<div class="nmenu" data-menu>
  <script is:inline>
    // menu.ts lays the menu out on the lattice: hide it until then (no jump from the fallback
    // layout). Power-on intro: nodes start dark, before the first paint; skipped under reduced
    // motion and on a quick return from a project page (the view transition collapses into a lit
    // node). If the client entry never runs, the plain layout shows and everything lights.
    (() => {
      const root = document.currentScript.parentElement;
      const html = document.documentElement;
      root.dataset.js = '';
      setTimeout(() => {
        if ('laid' in root.dataset) return;
        delete root.dataset.js;
        delete root.dataset.intro;
      }, 3000);
      if (html.dataset.motion === 'reduce' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        const r = JSON.parse(sessionStorage.getItem('gero-vt') || 'null');
        if (r && typeof r.t === 'number' && Date.now() - r.t < 30000) return;
      } catch {
        /* storage unavailable: play the intro */
      }
      root.dataset.intro = '';
    })();
  </script>

  <div class="nmenu__map" aria-hidden="true">
    <canvas class="nmenu__layer" data-mesh></canvas>
    <canvas class="nmenu__layer" data-corridors></canvas>
    <canvas class="nmenu__layer" data-electrons></canvas>
  </div>
  <!-- Outside the map: the map keeps the full menu height while a collapsed section shortens the menu. -->
  <div class="nmenu__vignette" aria-hidden="true"></div>

  <div class="nmenu__content" data-content>
    <!-- The root node: the power source. Not a link; the page's h1. -->
    <header class="mroot" data-root>
      <span class="mroot__glyph" data-root-glyph aria-hidden="true">
        <svg class="mnode__ring" viewBox="0 0 100 100">
          <path class="mnode__ring-base" d={RING} pathLength="100" />
          <path class="mnode__ring-fill" d={RING} pathLength="100" data-ring />
        </svg>
        <span class="mnode__charge"></span>
        <span class="mroot__photo">
          <Image src={gero} width={104} widths={[52, 104, 156]} sizes="52px" alt="" loading="eager" decoding="async" />
        </span>
      </span>
      <span class="mroot__plate glass">
        <p class="mroot__kicker mono">Geronimo Molina</p>
        <h1 class="mroot__name">Gero</h1>
        <p class="mroot__line">
          <span class="mroot__part">MBA + MEng Candidate</span><span class="mroot__sep">&nbsp;· </span><span
            class="mroot__part">UC Berkeley, California</span>
        </p>
      </span>
    </header>

    <nav class="nmenu__sections" id="menu-nodes" aria-label="About me and projects">
      {
        groups.map((group) => (
          <section class={`msec msec--${group.key}`} data-section={group.key} aria-labelledby={`msec-${group.key}-switch`}>
            <div class="mfence" data-fence aria-hidden="true">
              <span class="mfence__label mono">{group.label}</span>
            </div>
            <button
              class="mswitch"
              type="button"
              id={`msec-${group.key}-switch`}
              data-switch
              aria-expanded="true"
              aria-controls={`msec-${group.key}`}>
              <span class="mswitch__glyph" data-switch-glyph aria-hidden="true">
                <svg class="mnode__ring" viewBox="0 0 100 100">
                  <path class="mnode__ring-base" d={RING} pathLength="100" />
                  <path class="mnode__ring-fill" d={RING} pathLength="100" data-ring />
                </svg>
                <span class="mnode__charge" />
                <span class="mswitch__core" />
              </span>
              <span class="mswitch__label">{group.label}</span>
              <span class="mswitch__chev" aria-hidden="true">
                ▾
              </span>
              <span class="mswitch__count mono" aria-hidden="true">
                {group.count}
              </span>
            </button>
            <ul class="msec__list" id={`msec-${group.key}`} role="list" data-list>
              {group.entries.map((n, j) => (
                <li class="mitem" data-menu-item>
                  <a
                    class:list={['mnode', `mnode--${n.kind}`, n.badge && `mnode--${n.badge}`]}
                    href={n.href}
                    role={n.href ? undefined : 'link'}
                    aria-disabled={n.href ? undefined : 'true'}
                    tabindex={n.href ? undefined : -1}
                    data-menu-node={group.offset + j}
                    data-id={n.id}
                    data-soon={n.href ? undefined : ''}
                    data-fill={n.fill === undefined ? undefined : String(n.fill)}>
                    <span class="mnode__glyph" data-menu-glyph aria-hidden="true">
                      <svg class="mnode__ring" viewBox="0 0 100 100">
                        <path class="mnode__ring-base" d={n.kind === 'substation' ? SQUARE : RING} pathLength="100" />
                        <path class="mnode__ring-fill" d={n.kind === 'substation' ? SQUARE : RING} pathLength="100" data-ring />
                      </svg>
                      <span class="mnode__charge" />
                      {(n.kind === 'plant' || n.kind === 'section' || n.kind === 'game') && <span class="mnode__core" />}
                      {n.kind === 'substation' && (
                        <svg class="mnode__lock" viewBox="0 0 16 16">
                          <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>
                      )}
                    </span>
                    <span class="mnode__plate glass">
                      {n.badge && (
                        <span class="mnode__badge mono">
                          {n.badge === 'live' ? (
                            <>
                              <span aria-hidden="true">●</span> Live
                            </>
                          ) : n.badge === 'private' ? (
                            <>
                              <svg class="mnode__badge-lock" viewBox="0 0 16 16" aria-hidden="true">
                                <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                                <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
                              </svg>{' '}
                              Mine
                            </>
                          ) : n.badge === 'play' ? (
                            <>
                              <span aria-hidden="true">▶</span> Play
                            </>
                          ) : n.badge === 'soon' ? (
                            <>
                              <span aria-hidden="true">◌</span> Soon
                            </>
                          ) : (
                            <>
                              <span aria-hidden="true">‹/›</span> Code
                            </>
                          )}
                        </span>
                      )}
                      <span class="mnode__title">{n.title}</span>
                      <span class="mnode__line mono">
                        {n.value && <span class="mnode__value">{n.value}</span>}{' '}
                        {n.short ? (
                          <>
                            <span class="mnode__full">{n.label}</span>
                            <span class="mnode__short">{n.short}</span>
                          </>
                        ) : (
                          n.label
                        )}
                      </span>
                      {!n.href && (
                        <span class="mnode__hint mono" aria-hidden="true">
                          Coming soon
                        </span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>
  </div>
</div>

<script>
  import { mountMenu } from '../grid/menu';
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) mountMenu(root);
</script>

<style>
  .nmenu {
    position: relative;
    min-height: max(560px, 100svh);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- the grid behind (menu.ts) ---------- */
  .nmenu__map {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(120% 80% at 30% 20%, var(--bg-raise) 0%, var(--bg) 62%);
  }
  .nmenu__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .nmenu__vignette {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(130% 100% at 45% 35%, transparent 55%, rgba(4, 7, 11, 0.85) 100%),
      linear-gradient(to bottom, transparent 85%, var(--bg) 100%);
  }

  /* ---------- fallback layout (no JS yet, or none at all): a plain stacked list ---------- */
  .nmenu__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 4.5rem var(--gutter) 4rem;
  }
  .nmenu[data-js]:not([data-laid]) .nmenu__content {
    visibility: hidden;
  }
  .nmenu__sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .msec {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .msec__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
    gap: 2.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mfence {
    display: none;
  }

  /* ---------- lattice layout (menu.ts): everything absolutely placed on vertices ---------- */
  .nmenu[data-laid] .nmenu__content {
    display: block;
    padding: 0;
  }
  /* The wrappers keep their semantics but stop taking part in layout: full-size, click-through layers. */
  .nmenu[data-laid] :is(.nmenu__sections, .msec, .msec__list) {
    display: block;
    position: absolute;
    inset: 0;
    margin: 0;
    pointer-events: none;
  }
  .nmenu[data-laid] :is(.mroot, .mswitch, .mitem, .mfence) {
    position: absolute;
  }
  .nmenu[data-laid] :is(.mswitch, .mitem) {
    pointer-events: auto;
  }
  .nmenu[data-laid] .mfence {
    display: block;
  }

  /* ---------- the root node ---------- */
  .mroot {
    --power: 1;
    --charge: 0;
    --pulse: 0;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .nmenu[data-laid] .mroot {
    translate: 0 -50%;
  }
  .mroot__glyph {
    --glyph: 64px;
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow:
      0 0 calc(6px + var(--power) * 26px) rgba(var(--cyan-rgb), calc(0.1 + var(--power) * 0.45)),
      0 0 calc(var(--power) * 60px) rgba(var(--cyan-rgb), calc(var(--power) * 0.18));
  }
  .mroot__photo {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    overflow: hidden;
    opacity: calc(0.35 + var(--power) * 0.65);
  }
  .mroot__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
    /* The duotone filter is defined once, in About.astro (later in the page). */
    filter: url(#gero-duotone);
  }
  .mroot .mnode__ring path {
    stroke-width: 2;
  }
  .mroot .mnode__ring-fill {
    stroke: var(--hot);
    filter: drop-shadow(0 0 calc(2px + var(--power) * 5px) rgba(var(--cyan-rgb), 0.9));
  }
  .mroot__plate {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 0.5625rem;
    border-radius: var(--radius-md);
  }
  .mroot__kicker {
    margin: 0;
    font-size: 0.625rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .mroot__name {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    /* Same gradient as v2's header (ProjectMenu.astro). */
    background: linear-gradient(180deg, #fff 30%, #9fdcec 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mroot__line {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
  /* Phones: two clean lines, no separator dot left hanging. */
  @media (max-width: 767px) {
    .mroot__plate {
      padding: 0.3125rem 0.875rem 0.375rem;
    }
    .mroot__line {
      line-height: 1.3;
    }
    .mroot__part {
      display: block;
    }
    .mroot__sep {
      display: none;
    }
  }

  /* ---------- fences: a thin dashed outline on lattice lines, the label on the line ---------- */
  .mfence {
    border: 1px dashed rgba(var(--cyan-rgb), 0.32);
    border-radius: 12px;
    pointer-events: none;
  }
  .mfence__label {
    position: absolute;
    top: 0;
    left: 0.875rem;
    translate: 0 -50%;
    padding: 0 0.375rem;
    background: var(--bg);
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-2);
  }
  .msec--projects .mfence__label {
    color: var(--cyan);
  }

  /* ---------- section switch: a glyph and a label, a real button ---------- */
  .mswitch {
    --power: 1;
    --charge: 0;
    --pulse: 0;
    --glow: 0;
    --chev: 0;
    --open: 1;
    --press: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    margin: 0;
    padding: 0 0.75rem 0 0;
    border: 0;
    border-radius: 999px;
    background: none;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform: scale(var(--press));
    transform-origin: 14px 50%;
  }
  .nmenu[data-laid] .mswitch {
    translate: 0 -50%;
  }
  .mswitch:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }
  .mswitch__glyph {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 calc(3px + var(--power) * 6px + var(--pulse) * 16px)
      rgba(var(--cyan-rgb), calc(var(--power) * 0.3 + var(--pulse) * 0.4 + var(--glow) * 0.15));
    transform: scale(calc(1 + var(--pulse) * 0.12));
  }
  .mswitch__core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 8px 1px rgba(var(--cyan-rgb), 0.8);
    opacity: calc(0.15 + var(--power) * 0.85);
  }
  .mswitch__label {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .mswitch__chev {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--ink-2);
    rotate: calc(var(--chev) * -90deg);
  }
  .mswitch__count {
    font-size: 0.6875rem;
    color: var(--muted);
    opacity: calc(1 - var(--open));
  }
  @media (hover: hover) {
    .mswitch:hover .mswitch__label {
      color: var(--hot);
    }
  }

  /* ---------- children: one node object, plates hanging (projects, desktop) or beside ---------- */
  .mitem {
    --shown: 1;
    --fx: 0px;
    --fy: 0px;
    display: flex;
  }
  .nmenu[data-laid] .mitem {
    width: var(--item-w);
    opacity: var(--shown);
    transform: translate(calc((1 - var(--shown)) * var(--fx)), calc((1 - var(--shown)) * var(--fy)))
      scale(calc(0.72 + 0.28 * var(--shown)));
  }
  .mnode {
    --glyph: 44px;
    --power: 1;
    --pulse: 0;
    --glow: 0;
    --charge: 0;
    --lift: 0;
    --press: 1;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transform: translateY(calc(var(--lift) * 1px)) scale(var(--press));
  }
  .mnode[href] {
    cursor: pointer;
  }
  .nmenu[data-intro] :is(.mnode, .mswitch, .mroot) {
    --power: 0;
  }

  /* Glyph: the plant, substation or section ring. Its ring fills and lights as power arrives. */
  .mnode__glyph {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--glyph);
    height: var(--glyph);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--cyan-rgb), calc(0.04 + var(--power) * 0.16)) 0%, var(--bg) 70%);
    box-shadow: 0 0 calc(4px + var(--power) * 6px + var(--pulse) * 22px)
      rgba(var(--cyan-rgb), calc(var(--power) * 0.22 + var(--pulse) * 0.45 + var(--glow) * 0.12));
    transform: scale(calc(1 + var(--pulse) * 0.1));
  }
  .mnode--substation .mnode__glyph {
    border-radius: 28%;
    color: var(--amber);
    background: var(--bg);
    box-shadow: 0 0 calc(4px + var(--power) * 6px + var(--pulse) * 18px)
