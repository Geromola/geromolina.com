---
// Home hero v3.1 (SPEC "Home hero v3: the node menu"): a compact profile header (top-left), the
// section nav (top right) and two zones of grid nodes, PROJECTS and ABOUT ME. Every node is the
// same object, a glyph plus a glass plate fused into one link. `src/grid/menu.ts` snaps the glyphs
// to lattice vertices and runs the decorative flow (the plants feed every node in both zones along
// lit corridors) on the canvases behind them.
//
// The grid is sized so a 64px lattice fits it exactly (16px root): columns 13.5rem + 2.5rem = 4
// spacings apart, rows 126px + 66px = 3 spacings, the ABOUT ME column 5 spacings right of the last
// project column, and each zone label centred one spacing above its first glyphs. menu.ts still
// nudges whatever doesn't fit (another root size, the narrower layouts).
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import gero from '../assets/gero.jpg';
import SectionNav from './SectionNav.astro';

type Kind = 'plant' | 'substation' | 'section';
type Badge = 'live' | 'code' | 'private' | 'soon' | null;

interface Entry {
  id: string;
  kind: Kind | 'soon';
  badge: Badge;
  title: string;
  /** The one short line under the title: a metric (mono value + label) or a phrase. */
  value?: string;
  label: string;
  /** No href: not a link yet (rendered disabled). */
  href?: string;
  /** A live plant: it feeds the flow. */
  source: boolean;
  /** How far its ring fills once powered (1 unless under construction). */
  fill?: number;
}

// Only these kinds are menu nodes; anything else in the collection (e.g. `kind: game`) is ignored.
const KINDS: readonly string[] = ['plant', 'substation', 'section'];
const all = (await getCollection('nodes'))
  .map((e) => e.data)
  .filter((n): n is typeof n & { kind: Kind } => KINDS.includes(n.kind))
  .sort((a, b) => a.order - b.order);
const byId = new Map(all.map((n) => [n.id, n]));
const pick = (ids: string[]) => ids.flatMap((id) => (byId.has(id) ? [byId.get(id)!] : []));

// The tracker has no metric in the collection.
const TRACKER_LINE = 'Private · sign-in';

// Short map lines that fit the plate without an ellipsis (the full metrics live on the project pages).
const SHORT: Record<string, { value: string; label: string }> = {
  'spotify-insight': { value: '660,622', label: 'reviews' },
  'custom-llm': { value: '122K', label: 'parameters' },
  'personal-wiki': { value: '100%', label: 'offline' },
  'pacman-dqn': { value: '3.4×', label: 'baseline score' },
};

const toEntry = (n: (typeof all)[number]): Entry => ({
  id: n.id,
  kind: n.kind,
  badge: n.kind === 'section' ? null : n.status === 'live' ? 'live' : n.status === 'private' ? 'private' : 'code',
  title: n.title,
  value: SHORT[n.id]?.value ?? n.metrics?.[0]?.value,
  label: SHORT[n.id]?.label ?? n.metrics?.[0]?.label ?? (n.kind === 'substation' ? TRACKER_LINE : n.kicker),
  href: n.href,
  source: n.kind === 'plant' && n.status === 'live',
});

/* ========================= Ballpark placeholder (SPEC "Home hero v3") =========================
   Hardcoded, not from the collection: a PROJECTS node that is a load in the flow, but its ring
   stays half-lit while it's under construction. No href, so it renders as a disabled link
   (role="link", aria-disabled, tabindex -1). To launch it, add `href: '/ballpark'`, set the badge
   to 'code' (or the game's own), swap the line for a metric and drop `fill`. */
const BALLPARK: Entry = {
  id: 'ballpark',
  kind: 'soon',
  badge: 'soon',
  title: 'Ballpark',
  label: 'In construction',
  source: false,
  fill: 0.5,
};
/* ===================== end of the Ballpark placeholder ===================== */

// PROJECTS, in this order (don't reorder `order` in the content for it); any other plant or
// substation joins at the end.
const LISTED = ['spotify-insight', 'custom-llm', 'personal-wiki', 'pacman-dqn', 'networking-tracker'];
const extraProjects = all.filter((n) => n.kind !== 'section' && !LISTED.includes(n.id));
const projects: Entry[] = [
  ...pick(LISTED.slice(0, 4)).map(toEntry),
  BALLPARK,
  ...pick(LISTED.slice(4)).map(toEntry),
  ...extraProjects.map(toEntry),
];

// ABOUT ME: the page sections, each with a short line in place of a metric.
const ABOUT_LINES: Record<string, string> = {
  about: 'Who I am',
  'off-the-grid': 'Muay Thai, cycling, an ACS paper',
  contact: 'Email · LinkedIn · GitHub',
};
const ABOUT = ['about', 'off-the-grid', 'contact'];
const sections = [...pick(ABOUT), ...all.filter((n) => n.kind === 'section' && !ABOUT.includes(n.id))];
const about: Entry[] = sections.map((n) => ({ ...toEntry(n), label: ABOUT_LINES[n.id] ?? n.title }));

// Node indices in DOM order: the projects, then about me.
const zones = [
  { key: 'projects', label: 'Projects', entries: projects, offset: 0 },
  { key: 'about', label: 'About me', entries: about, offset: projects.length },
];

// A circle and a rounded square as paths (start at the top, clockwise), so `pathLength` works everywhere.
const RING = 'M50 4 a46 46 0 1 1 0 92 a46 46 0 1 1 0 -92';
const SQUARE = 'M50 4 H74 a22 22 0 0 1 22 22 V74 a22 22 0 0 1 -22 22 H26 a22 22 0 0 1 -22 -22 V26 a22 22 0 0 1 22 -22 Z';
---

<SectionNav />
<div class="nmenu" data-menu>
  <script is:inline>
    // Power-on intro (menu.ts): nodes start dark, before the first paint. Skipped under reduced
    // motion and on a quick return from a project page (the view transition collapses into a lit
    // node). If the client entry never runs, everything lights after a moment.
    (() => {
      const root = document.currentScript.parentElement;
      const html = document.documentElement;
      if (html.dataset.motion === 'reduce' || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      try {
        const r = JSON.parse(sessionStorage.getItem('gero-vt') || 'null');
        if (r && typeof r.t === 'number' && Date.now() - r.t < 30000) return;
      } catch {
        /* storage unavailable: play the intro */
      }
      root.dataset.intro = '';
      setTimeout(() => {
        if (!('ready' in root.dataset)) delete root.dataset.intro;
      }, 4000);
    })();
  </script>

  <div class="nmenu__map" aria-hidden="true">
    <canvas class="nmenu__layer" data-mesh></canvas>
    <canvas class="nmenu__layer" data-corridors></canvas>
    <canvas class="nmenu__layer" data-electrons></canvas>
    <div class="nmenu__vignette"></div>
  </div>

  <div class="nmenu__content">
    <header class="profile">
      <span class="profile__photo">
        <Image src={gero} width={88} widths={[44, 88, 132]} sizes="44px" alt="" loading="eager" decoding="async" />
      </span>
      <span class="profile__text">
        <p class="profile__kicker mono">Geronimo Molina</p>
        <h1 class="profile__name">Gero</h1>
        <p class="profile__line">MBA + MEng Candidate&nbsp;· UC Berkeley, California</p>
      </span>
    </header>

    <nav class="nmenu__zones" id="menu-nodes" aria-label="Projects and sections">
      {
        zones.map((zone) => (
          <section class={`zone zone--${zone.key}`} aria-labelledby={`zone-${zone.key}`}>
            <h2 class="zone__label mono" id={`zone-${zone.key}`}>
              {zone.label}
            </h2>
            <ul class="zone__grid" role="list" data-flow={zone.key === 'projects' ? 0 : 1}>
              {zone.entries.map((n, j) => (
                <li class="nmenu__item" data-menu-item>
                  <a
                    class:list={['mnode', `mnode--${n.kind}`, n.badge && `mnode--${n.badge}`]}
                    href={n.href}
                    role={n.href ? undefined : 'link'}
                    aria-disabled={n.href ? undefined : 'true'}
                    tabindex={n.href ? undefined : -1}
                    data-menu-node={zone.offset + j}
                    data-id={n.id}
                    data-source={n.source ? '' : undefined}
                    data-soon={n.href ? undefined : ''}
                    data-fill={n.fill === undefined ? undefined : String(n.fill)}>
                    <span class="mnode__glyph" data-menu-glyph aria-hidden="true">
                      <svg class="mnode__ring" viewBox="0 0 100 100">
                        <path class="mnode__ring-base" d={n.kind === 'substation' ? SQUARE : RING} pathLength="100" />
                        <path class="mnode__ring-fill" d={n.kind === 'substation' ? SQUARE : RING} pathLength="100" data-ring />
                      </svg>
                      <span class="mnode__charge" />
                      {n.kind === 'plant' && <span class="mnode__core" />}
                      {n.kind === 'substation' && (
                        <svg class="mnode__lock" viewBox="0 0 16 16">
                          <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                          <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        </svg>
                      )}
                    </span>
                    <span class="mnode__plate glass">
                      {n.badge && (
                        <span class="mnode__badge mono">
                          {n.badge === 'live' ? (
                            <>
                              <span aria-hidden="true">●</span> Live
                            </>
                          ) : n.badge === 'private' ? (
                            <>
                              <svg class="mnode__badge-lock" viewBox="0 0 16 16" aria-hidden="true">
                                <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
                                <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.6" />
                              </svg>{' '}
                              Mine
                            </>
                          ) : n.badge === 'soon' ? (
                            <>
                              <span aria-hidden="true">◌</span> Soon
                            </>
                          ) : (
                            <>
                              <span aria-hidden="true">‹/›</span> Code
                            </>
                          )}
                        </span>
                      )}
                      <span class="mnode__title">{n.title}</span>
                      <span class="mnode__line mono">
                        {n.value && <span class="mnode__value">{n.value}</span>} {n.label}
                      </span>
                      {!n.href && (
                        <span class="mnode__hint mono" aria-hidden="true">
                          Coming soon
                        </span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </nav>
  </div>
</div>

<script>
  import { mountMenu } from '../grid/menu';
  const root = document.querySelector<HTMLElement>('[data-menu]');
  if (root) mountMenu(root);
</script>

<style>
  .nmenu {
    position: relative;
    min-height: max(560px, 100svh);
    overflow: hidden;
    isolation: isolate;
  }

  /* ---------- the grid behind (menu.ts) ---------- */
  .nmenu__map {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(120% 80% at 50% 30%, var(--bg-raise) 0%, var(--bg) 62%);
  }
  .nmenu__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .nmenu__vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(130% 100% at 50% 40%, transparent 55%, rgba(4, 7, 11, 0.85) 100%),
      linear-gradient(to bottom, transparent 80%, var(--bg) 100%);
  }

  .nmenu__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--gutter) var(--gutter) clamp(3rem, 8vh, 5rem);
  }

  /* ---------- compact profile header, top-left (the section nav is on the same row) ---------- */
  .profile {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    /* Centred on the section nav's row. */
    margin-top: -0.5rem;
  }
  .profile__photo {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid var(--cyan);
    box-shadow: 0 0 16px rgba(var(--cyan-rgb), 0.3);
    background: var(--bg);
  }
  .profile__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 48%;
    /* The duotone filter is defined once, in About.astro (later in the page). */
    filter: url(#gero-duotone);
  }
  .profile__text {
    display: flex;
    flex-direction: column;
    max-width: 19rem;
  }
  .profile__kicker {
    margin: 0;
    font-size: 0.625rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .profile__name {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    /* Same gradient as v2's header (ProjectMenu.astro). */
    background: linear-gradient(180deg, #fff 30%, #9fdcec 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .profile__line {
    margin: 0.125rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ink-2);
    text-wrap: balance;
  }

  /* ---------- the two zones ---------- */
  .nmenu__zones {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 6.5rem;
    width: 100%;
    margin-top: clamp(1.75rem, 5vh, 3rem);
  }
  .zone {
    display: flex;
    flex-direction: column;
  }
  /* A mono kicker sitting on a conductor, one lattice row above the zone's first glyphs. */
  .zone__label {
    margin: 0 0 2.125rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .zone--about .zone__label {
    color: var(--ink-2);
  }
  .zone__grid {
    display: grid;
    grid-template-columns: repeat(3, var(--plate-w));
    column-gap: 2.5rem;
    row-gap: 4.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    --plate-w: 13.5rem;
  }
  .zone--about .zone__grid {
    grid-template-columns: var(--plate-w);
  }
  /* menu.ts measures the glyphs untransformed. */
  .nmenu.is-measuring .mnode {
    transform: none !important;
  }
  /* menu.ts snaps each glyph to a lattice vertex: a small sideways nudge and a top margin. */
  .nmenu__item {
    display: flex;
    margin-top: var(--snap-y, 0px);
    translate: var(--snap-x, 0px) 0;
  }

  /* ---------- the node object: glyph + plate, one link, one size ---------- */
  .mnode {
    --glyph: 44px;
    --power: 1;
    --pulse: 0;
    --glow: 0;
    --charge: 0;
    --lift: 0;
    --press: 1;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transform: translateY(calc(var(--lift) * 1px)) scale(var(--press));
  }
  .mnode[href] {
    cursor: pointer;
  }
  .nmenu[data-intro] .mnode {
    --power: 0;
  }

  /* Glyph: the plant, substation or section ring. Its ring fills and lights as power arrives. */
  .mnode__glyph {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--glyph);
    height: var(--glyph);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--cyan-rgb), calc(0.04 + var(--power) * 0.16)) 0%, var(--bg) 70%);
    box-shadow: 0 0 calc(4px + var(--power) * 6px + var(--pulse) * 22px)
      rgba(var(--cyan-rgb), calc(var(--power) * 0.22 + var(--pulse) * 0.45 + var(--glow) * 0.12));
    transform: scale(calc(1 + var(--pulse) * 0.1));
  }
  .mnode--section .mnode__glyph {
    background: var(--bg);
  }
  .mnode--substation .mnode__glyph {
    border-radius: 28%;
    color: var(--amber);
    background: var(--bg);
    box-shadow: 0 0 calc(4px + var(--power) * 6px + var(--pulse) * 18px)
      rgba(var(--amber-rgb), calc(var(--power) * 0.25 + var(--pulse) * 0.45 + var(--glow) * 0.12));
  }
  .mnode__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .mnode__ring path {
    fill: none;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .mnode__ring-base {
    stroke: rgba(232, 241, 245, 0.22);
  }
  .mnode__ring-fill {
    stroke: var(--cyan);
    stroke-dasharray: 100 0;
    filter: drop-shadow(0 0 calc(1px + var(--power) * 2px + var(--glow) * 4px) rgba(var(--cyan-rgb), 0.7));
  }
  .nmenu[data-intro] .mnode__ring-fill {
    stroke-dasharray: 0 100;
  }
  .mnode--substation .mnode__ring-base {
    stroke: rgba(var(--amber-rgb), 0.3);
  }
  .mnode--substation .mnode__ring-fill {
    stroke: var(--amber);
    filter: drop-shadow(0 0 calc(1px + var(--power) * 2px + var(--glow) * 4px) rgba(var(--amber-rgb), 0.7));
  }
  .mnode.is-hot .mnode__ring-fill {
    stroke: var(--hot);
  }
  .mnode--substation.is-hot .mnode__ring-fill {
    stroke: var(--amber);
  }
  .mnode__core {
    width: calc(var(--glyph) * 0.3);
    height: calc(var(--glyph) * 0.3);
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 calc(var(--glyph) * 0.3) calc(var(--glyph) * 0.06) rgba(var(--cyan-rgb), 0.8);
    opacity: calc(0.12 + var(--power) * 0.88);
  }
  .mnode__lock {
    width: calc(var(--glyph) * 0.42);
    height: calc(var(--glyph) * 0.42);
    opacity: calc(0.35 + var(--power) * 0.65);
  }
  /* Charge sweep: a hot arc swept 0→360° by --charge (menu.ts), on press and at ignition. */
  .mnode__charge {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid var(--hot);
    box-shadow:
      0 0 8px rgba(var(--cyan-rgb), 0.9),
      inset 0 0 6px rgba(var(--cyan-rgb), 0.6);
    pointer-events: none;
    -webkit-mask-image: conic-gradient(black calc(var(--charge) * 1turn), transparent 0);
    mask-image: conic-gradient(black calc(var(--charge) * 1turn), transparent 0);
  }
  .mnode--substation .mnode__charge {
    border-radius: 32%;
  }

  /* Under construction: a dashed ring that only ever fills halfway. */
  .mnode--soon .mnode__ring-base {
    stroke: var(--muted);
    stroke-dasharray: 4 4;
  }
  .mnode--soon .mnode__ring-fill {
    stroke-dasharray: 50 100;
  }
  .mnode--soon {
    cursor: default;
  }

  /* Plate: hangs under the glyph, which overlaps its top edge. One fixed size, so rows align. */
  .mnode__plate {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 6.5rem;
    margin-top: calc(var(--glyph) / -2);
    padding: calc(var(--glyph) / 2 + 0.5rem) 1rem 0.625rem;
    border-radius: var(--radius-md);
    text-align: center;
    transition: border-color 150ms ease-out;
  }
  /* ABOUT ME plates have no badge: the title and its line sit centred in the space below the glyph. */
  .mnode--section .mnode__plate {
    justify-content: center;
    padding-bottom: calc(0.625rem + 0.5rem);
  }
  .mnode.is-hot .mnode__plate {
    border-color: rgba(var(--cyan-rgb), 0.36);
    border-top-color: rgba(var(--cyan-rgb), 0.5);
  }
  .mnode--substation .mnode__plate {
    border-color: rgba(var(--amber-rgb), 0.4);
  }
  .mnode--substation.is-hot .mnode__plate {
    border-color: var(--amber);
  }
  .mnode:focus-visible {
    outline: none;
  }
  .mnode:focus-visible .mnode__plate {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
  }

  .mnode__badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mnode--live .mnode__badge {
    color: var(--cyan);
  }
  .mnode--private .mnode__badge {
    color: var(--amber);
  }
  .mnode__badge-lock {
    width: 0.75rem;
    height: 0.75rem;
  }
  .mnode__title {
    max-width: 100%;
    margin-top: 0.25rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mnode__line {
    max-width: 100%;
    margin-top: 0.3rem;
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--ink-2);
  }
  .mnode__value {
    color: var(--cyan);
  }
  /* ABOUT ME has no badge row, so its phrase may take two lines instead of an ellipsis. */
  .mnode--section .mnode__line {
    white-space: normal;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    line-height: 1.4;
  }

  /* "Coming soon": a small hint just under the plate, on hover or press. */
  .mnode__hint {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.5rem);
    translate: -50% 0;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--glass-edge);
    background: var(--bg-raise);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    color: var(--ink-2);
    opacity: 0;
    transition: opacity 150ms ease-out;
    pointer-events: none;
  }
  .mnode--soon.is-hot .mnode__hint,
  .mnode--soon.is-hinting .mnode__hint {
    opacity: 1;
  }

  /* ---------- below 1120px: projects in 2 columns (3 rows), ABOUT ME still on the right ---------- */
  @media (max-width: 1119px) {
    .zone--projects .zone__grid {
      grid-template-columns: repeat(2, var(--plate-w));
    }
  }
  /* Narrow tablets: a 58px lattice (columns 4 spacings apart, rows 3, ABOUT ME 4 to the right). */
  @media (min-width: 721px) and (max-width: 879px) {
    .nmenu__zones {
      gap: 2.5rem;
    }
    .zone__grid {
      --plate-w: 12rem;
      row-gap: 3rem;
    }
  }

  /* ---------- phones: the header under the nav pill, then both zones in one column on the spine ---------- */
  @media (max-width: 720px) {
    .nmenu__content {
      padding-top: 4.25rem;
      align-items: stretch;
