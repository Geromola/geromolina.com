---
// Raup's Cube (SPEC "Raup's Cube"): three numbers that decide how a coiled shell looks.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TopBar from '../components/project/TopBar.astro';
import { CATALOG } from '../shells/catalog';
import { LESSONS } from '../shells/lessons';
import { PRESETS, ticks, type ParamKey, type Region } from '../shells/model';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/shells/*.jpg', { eager: true });
const photo = (id: string) => photos[`../assets/shells/${id}.jpg`].default;
const GROUP: Record<Region['id'], string> = {
  cephalopods: 'Cephalopod',
  gastropods: 'Snail',
  bivalves: 'Bivalve',
  brachiopods: 'Brachiopod',
};

const CONTROLS: { key: ParamKey; name: string; help: string; aria: string }[] = [
  { key: 'W', name: 'Whorl expansion', help: 'How much the tube grows in one turn', aria: 'W, whorl expansion rate (log scale)' },
  { key: 'D', name: 'Distance from the axis', help: 'Inner edge ÷ outer edge of the tube', aria: 'D, distance from the coiling axis' },
  { key: 'T', name: 'Translation', help: 'How far the tube slides down the axis', aria: 'T, translation rate along the axis' },
];
---

<Base
  title="Raup's Cube · Gero Molina"
  description="Raup's Cube: every coiled shell is one tube that grows as it turns. Three numbers, W, D and T, decide how it looks. Grow a nautilus, a snail and a clam, then explore the shells evolution never built."
>
  <TopBar title="Raup's Cube" />
  <main class="rc" data-shells data-focus="" data-cube="hidden">
    <header class="rc__head">
      <p class="rc__kicker mono">Theoretical morphology · 1966</p>
      <h1 class="rc__title">Raup's Cube</h1>
      <p class="rc__lede">Every coiled shell is one tube that grows as it turns. Three numbers decide how it looks.</p>
    </header>

    <div class="lab">
      <div class="view glass" data-view>
        <canvas class="view__canvas" data-shell role="img" aria-label="A 3D shell. Drag sideways to turn it."></canvas>
        <div class="view__bar">
          <button class="chip" type="button" data-regrow><span aria-hidden="true">↻</span> Grow again</button>
          <button class="chip" type="button" data-pair aria-pressed="false" hidden>Pair valves</button>
        </div>
        <p class="view__touch mono" data-touch></p>
      </div>

      <div class="side">
      <section class="panel glass" aria-labelledby="rc-lesson-title">
        <div class="lesson">
          <p class="lesson__step mono">Step <b data-step>1</b> / {LESSONS.length}</p>
          <h2 class="lesson__title" id="rc-lesson-title" data-lesson-title>{LESSONS[0].title}</h2>
          <p class="lesson__body" data-lesson-body>{LESSONS[0].body}</p>
          <div class="lesson__nav">
            <button class="btn btn--quiet" type="button" data-prev disabled>Back</button>
            <button class="btn" type="button" data-next>Next</button>
          </div>
          <ol class="dots" role="list">
            {
              LESSONS.map((l, i) => (
                <li>
                  <button class="dot" type="button" data-dot={i} aria-label={`Step ${i + 1}: ${l.title}`} />
                </li>
              ))
            }
          </ol>
        </div>

        <div class="controls">
          {
            CONTROLS.map((c) => (
              <div class="ctl" data-ctl={c.key}>
                <div class="ctl__head">
                  <span class="ctl__key mono">{c.key}</span>
                  <span class="ctl__name">{c.name}</span>
                  <span class="ctl__value mono" data-value />
                </div>
                <div class="track" data-track>
                  <span class="track__line" aria-hidden="true" />
                  <span class="track__ticks" aria-hidden="true">
                    {ticks(c.key).map((t) => (
                      <span class="tick" style={`left: ${t.pos * 100}%`}>
                        <span class="tick__label mono">{t.label}</span>
                      </span>
                    ))}
                  </span>
                  <span class="track__thumb" data-thumb role="slider" tabindex="0" aria-label={c.aria} />
                </div>
                <p class="ctl__help">{c.help}</p>
              </div>
            ))
          }
        </div>

        <div class="ident">
          <button class="btn btn--wide" type="button" data-identify>What shell is this?</button>
          <div class="result" data-result hidden>
            <p class="result__stale" data-stale>Shell changed: identify again</p>
            <p class="result__tier mono" data-tier></p>
            {
              CATALOG.map((e) => (
                <article class="entry" data-entry={e.id} hidden aria-label={`${e.name}, ${e.latin}`}>
                  <figure class="entry__photo">
                    <Image
                      src={photo(e.id)}
                      width={640}
                      widths={[360, 640, 900]}
                      sizes="(max-width: 860px) 92vw, 26rem"
                      alt={`${e.name} (${e.latin})`}
                      loading="lazy"
                    />
                    <figcaption class="entry__credit">
                      Photo: <a href={e.image.source} target="_blank" rel="noopener">{e.image.author}</a>, {e.image.license}
                    </figcaption>
                  </figure>
                  <h3 class="entry__name">
                    {e.name} <i>{e.latin}</i>
                  </h3>
                  <p class="entry__meta">
                    <span class="entry__group mono">{GROUP[e.group]}</span> {e.habitat}
                  </p>
                  <h4 class="entry__h">What the shell is for</h4>
                  <p class="entry__use">{e.use}</p>
                  <ul class="entry__facts" role="list">
                    {e.facts.map((f) => (
                      <li>{f}</li>
                    ))}
                  </ul>
                  <div class="entry__actions">
                    <button class="btn" type="button" data-grow={e.id}>
                      Grow the real one
                    </button>
                    <a class="chip" href={e.wiki} target="_blank" rel="noopener">
                      Read more <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </article>
              ))
            }
            <p class="result__also">
              <span>Also close:</span>
              {
                CATALOG.map((e) => (
                  <button class="chip" type="button" data-also={e.id} hidden>
                    {e.name}
                  </button>
                ))
              }
            </p>
            <p class="result__note" data-note>
              Where whorls overlap, the animal reuses the old whorl as its inner wall. The render shows the buried part too.
            </p>
          </div>
        </div>
      </section>

      <section class="cube glass" data-cube-panel aria-labelledby="rc-cube-title">
      <div class="cube__head">
        <div>
          <p class="rc__kicker mono">Morphospace</p>
          <h2 class="cube__title" id="rc-cube-title">The cube</h2>
        </div>
        <p class="cube__lede">
          Each point is a shell. Drag across the map to set W and D, and the strip on the right for T. Below the amber
          line, whorls touch.
        </p>
      </div>
      <div class="map" data-map-wrap>
        <canvas class="map__canvas" data-map aria-hidden="true"></canvas>
      </div>
      <p class="where" data-where aria-hidden="true"></p>
      <div class="presets" role="group" aria-label="Real shells">
        {
          PRESETS.map((p) => (
            <button class="chip" type="button" data-preset={p.id} aria-pressed="false">
              {p.chip ?? p.name}
            </button>
          ))
        }
      </div>
      <div class="cube__foot">
        <button class="btn" type="button" data-random>Show me a shell that never existed</button>
        <button class="btn btn--quiet" type="button" data-skip>Show where real shells live</button>
      </div>
      <p class="note">
        Regions are approximate, after Raup (1966). The model assumes a circular tube and steady growth, so real shells
        only sit near their points.
      </p>
      </section>
      </div>
    </div>

    <section class="about" aria-labelledby="rc-about">
      <h2 id="rc-about">About the model</h2>
      <p>
        In the 1960s the paleontologist David Raup asked a computer to draw shells. He found that one rule covers nautiluses,
        ammonites, snails, clams and brachiopods: a tube that keeps its shape while it grows and turns around an axis. Three
        numbers set its form, so all possible shells fit in one cube, and real animals use only a small part of it.
      </p>
      <ul class="refs" role="list">
        <li>Raup, D. M. (1962). Computer as aid in describing form in gastropod shells. <i>Science</i> 138.</li>
        <li>Raup, D. M. (1966). Geometric analysis of shell coiling: general problems. <i>Journal of Paleontology</i> 40.</li>
        <li>McGhee, G. R. (1999). <i>Theoretical Morphology: The Concept and Its Applications</i>. Columbia University Press.</li>
      </ul>
    </section>

    <p class="vh" data-live role="status" aria-live="polite"></p>
    <noscript><p class="rc__lede">Raup's Cube needs JavaScript.</p></noscript>
  </main>
</Base>

<script>
  import { mountShells } from '../shells/main';
  const root = document.querySelector<HTMLElement>('[data-shells]');
  if (root) mountShells(root);
</script>

<style>
  .rc {
    max-width: 68rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 5rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.25rem);
  }
  .rc__kicker {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .rc__title {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .rc__lede {
    max-width: 34rem;
    margin: 1rem 0 0;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- lab: the shell stays in view while the lesson, controls and cube scroll ---------- */
  .lab {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 1fr);
    align-items: start;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    min-width: 0;
  }
  .panel,
  .cube {
    border-radius: var(--radius-lg);
    padding: clamp(1rem, 3vw, 1.75rem);
  }
  .view {
    position: sticky;
    top: 4.5rem;
    height: min(calc(100svh - 6rem), 44rem);
    min-height: 20rem;
    border-radius: var(--radius-lg);
    background-image: radial-gradient(circle at 50% 45%, rgba(var(--cyan-rgb), 0.07), transparent 65%);
    overflow: hidden;
  }
  .view__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
    /* Sideways drags turn the shell; vertical swipes still scroll the page. */
    touch-action: pan-y;
  }
  .view__canvas:active {
    cursor: grabbing;
  }
  .view__bar {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.5rem;
  }
  .view__touch {
    position: absolute;
    right: 0.75rem;
    bottom: 0.625rem;
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    pointer-events: none;
  }
  .view__touch[data-state='loose'] {
    color: var(--amber);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.04);
    color: var(--ink-2);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 550;
    text-decoration: none;
    cursor: pointer;
    transition:
      background 150ms ease-out,
      border-color 150ms ease-out,
      color 150ms ease-out;
  }
  .chip:hover {
    color: var(--ink);
    border-color: rgba(var(--cyan-rgb), 0.45);
  }
  .chip:active {
    transform: scale(0.97);
  }
  .chip[aria-pressed='true'] {
    color: var(--ink);
    border-color: rgba(var(--cyan-rgb), 0.7);
    background: rgba(var(--cyan-rgb), 0.14);
  }
  .chip:focus-visible {
    border-radius: 999px;
  }
  .chip[hidden] {
    display: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--cyan-rgb), 0.45);
    background: rgba(var(--cyan-rgb), 0.12);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 150ms ease-out,
      border-color 150ms ease-out;
  }
  .btn:hover:not(:disabled) {
    background: rgba(var(--cyan-rgb), 0.2);
    border-color: rgba(var(--cyan-rgb), 0.7);
  }
  .btn:active:not(:disabled) {
    transform: scale(0.97);
  }
  .btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .btn:focus-visible {
    border-radius: 999px;
  }
  .btn[hidden] {
    display: none;
  }
  .btn--quiet {
    border-color: var(--glass-border);
    background: transparent;
    color: var(--ink-2);
  }
  .btn--quiet:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--glass-edge);
  }

  /* ---------- lesson ---------- */
  .panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }
  .lesson__step {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lesson__step b {
    font-weight: 600;
    color: var(--ink);
  }
  .lesson__title {
    margin: 0.5rem 0 0.5rem;
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .lesson__body {
    margin: 0;
    min-height: 7.5em;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .lesson__nav {
    display: flex;
    gap: 0.625rem;
    margin-top: 1rem;
  }
  .lesson__nav .btn {
    min-width: 6.5rem;
  }
  .dots {
    display: flex;
    gap: 0.125rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dot {
    position: relative;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dot::before {
    content: '';
    position: absolute;
    inset: 50%;
    width: 0.4375rem;
    height: 0.4375rem;
    margin: -0.21875rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transition:
      background 150ms ease-out,
      transform 150ms ease-out;
  }
  .dot[aria-current='step']::before {
    background: var(--cyan);
    transform: scale(1.3);
  }
  .dot.is-seen::before {
    background: rgba(var(--cyan-rgb), 0.45);
  }

  /* ---------- controls ---------- */
  .controls {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }
  .ctl {
    --pos: 0;
    transition: opacity 200ms ease-out;
  }
  [data-focus='W'] .ctl:not([data-ctl='W']),
  [data-focus='D'] .ctl:not([data-ctl='D']),
  [data-focus='T'] .ctl:not([data-ctl='T']) {
    opacity: 0.5;
  }
  .ctl__head {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .ctl__key {
    font-size: 1rem;
    font-weight: 700;
    color: var(--cyan);
  }
  .ctl__name {
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .ctl__value {
    margin-left: auto;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .ctl__help {
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .track {
    position: relative;
    height: 2.25rem;
    margin: 0.25rem 0.5rem 0;
    touch-action: none;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .track__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.14);
  }
  .track__line::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--pos) * 100%);
    border-radius: 1px;
    background: rgba(var(--cyan-rgb), 0.7);
  }
  .tick {
    position: absolute;
    top: calc(50% + 0.3125rem);
    width: 1px;
    height: 0.3125rem;
    background: rgba(255, 255, 255, 0.25);
  }
  .tick__label {
    position: absolute;
    top: 0.5rem;
    left: 0;
    transform: translateX(-50%);
    font-size: 0.625rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .track__thumb {
    position: absolute;
    top: 50%;
    left: calc(var(--pos) * 100%);
    width: 2.75rem;
    height: 2.75rem;
    margin: -1.375rem 0 0 -1.375rem;
    border-radius: 50%;
  }
  .track__thumb::before {
    content: '';
    position: absolute;
    inset: 50%;
    width: 1rem;
    height: 1rem;
    margin: -0.5rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 4px rgba(var(--cyan-rgb), 0.18), 0 0 16px rgba(var(--cyan-rgb), 0.6);
    transition: transform 120ms ease-out;
  }
  .track.is-dragging .track__thumb::before {
    transform: scale(1.2);
  }
  .track__thumb:focus-visible {
    outline: none;
  }
  .track__thumb:focus-visible::before {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  [data-focus='W'] [data-ctl='W'] .track__thumb::before,
  [data-focus='D'] [data-ctl='D'] .track__thumb::before,
  [data-focus='T'] [data-ctl='T'] .track__thumb::before {
    animation: beckon 1.6s ease-in-out infinite;
  }
  @keyframes beckon {
    50% {
      box-shadow: 0 0 0 9px rgba(var(--cyan-rgb), 0.08), 0 0 22px rgba(var(--cyan-rgb), 0.8);
    }
  }

  /* ---------- identify ---------- */
  .ident {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .btn--wide {
    width: 100%;
  }
  .result {
    --in: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: var(--in);
    transform: translateY(calc((1 - var(--in)) * 0.75rem));
  }
  .result[hidden] {
    display: none;
  }
  .result__stale {
    display: none;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--amber);
  }
  .result.is-stale .result__stale {
    display: block;
  }
  .result.is-stale .entry,
  .result.is-stale .result__tier,
  .result.is-stale .result__also {
    opacity: 0.45;
    transition: opacity 200ms ease-out;
  }
  .result__tier {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .result__tier[data-tier='none'] {
    color: var(--amber);
  }
  .entry[hidden] {
    display: none;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .entry__photo {
    margin: 0;
  }
  .entry__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--bg-raise);
  }
  .entry__credit {
    margin-top: 0.375rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .entry__credit a {
    color: var(--ink-2);
  }
  .entry__name {
    margin: 0.25rem 0 0;
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .entry__name i {
    font-size: 0.9375rem;
    font-weight: 450;
    color: var(--ink-2);
  }
  .entry__meta,
  .entry__use {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .entry__group {
    margin-right: 0.375rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .entry__h {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink);
  }
  .entry__facts {
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .entry__facts li {
    position: relative;
    padding-left: 1rem;
  }
  .entry__facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: rgba(var(--cyan-rgb), 0.7);
  }
  .entry__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }
  .result__also {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .result__note {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .result__note[hidden] {
    display: none;
  }

  /* ---------- cube ---------- */
  .cube {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cube__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .cube__title {
    margin: 0;
