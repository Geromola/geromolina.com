---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/project/TopBar.astro';
import PlantGlyph from '../../components/project/PlantGlyph.astro';
import MetricTiles from '../../components/project/MetricTiles.astro';
import LiveEmbed from '../../components/project/LiveEmbed.astro';
import Pill from '../../components/project/Pill.astro';

export async function getStaticPaths() {
  const plants = await getCollection('nodes', (n) => n.data.kind === 'plant');
  return plants.map((entry) => ({
    params: { slug: entry.data.href.replace(/^\/projects\//, '').replace(/\/$/, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'nodes'>;
}

// Live apps whose headers forbid cross-origin framing (x-frame-options / frame-ancestors).
// Checked 2026-10-19: neither live URL sends either header.
const FRAMING_BLOCKED = new Set<string>();

const { entry } = Astro.props;
const { title, kicker, pitch, metrics, liveUrl, repo, embed } = entry.data;
const { Content } = await render(entry);
---

<Base title={`${title} · Gero Molina`} description={pitch}>
  <TopBar title={title} liveUrl={liveUrl} />
  <main class="project">
    <header class="hero">
      <p class="hero__kicker mono"><PlantGlyph />{kicker}</p>
      <h1 class="hero__title">{title}</h1>
      {pitch && <p class="hero__pitch">{pitch}</p>}
    </header>

    {metrics && <MetricTiles metrics={metrics} />}

    {embed && liveUrl && <LiveEmbed title={title} liveUrl={liveUrl} framable={!FRAMING_BLOCKED.has(entry.data.id)} />}

    <section class="how" aria-labelledby="how-it-works">
      <h2 id="how-it-works">How it works</h2>
      <div class="prose">
        <Content />
      </div>
      {
        repo && (
          <Pill href={repo} newTab class="how__source">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              />
            </svg>
            Source on GitHub <span aria-hidden="true">↗</span>
          </Pill>
        )
      }
    </section>
  </main>
  <footer class="footer">
    <p>© 2026 Geronimo Molina</p>
  </footer>
</Base>

<style>
  .project,
  .footer {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .hero__pitch {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.45;
    color: var(--ink-2);
  }

  .how h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 650;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .prose {
    max-width: 40rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .prose :global(p) {
    margin: 0 0 1em;
  }
  .prose :global(ul) {
    margin: 0 0 1.25em;
    padding: 0;
    list-style: none;
  }
  .prose :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }
  .prose :global(li + li) {
    margin-top: 0.5em;
  }
  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0.125rem;
    top: calc(0.825em - 3px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 6px rgba(var(--cyan-rgb), 0.6);
  }
  .prose > :global(:last-child) {
    margin-bottom: 0;
  }
  .how :global(.how__source) {
    margin-top: 2rem;
  }

  .footer {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
  }
  .footer p {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
