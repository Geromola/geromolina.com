                  </span>
                  <span class="compare__v mono"><span class="visually-hidden">cost </span><span data-c={`${c.id}-tl`}>—</span></span>
                  <span class="compare__v mono"><span class="visually-hidden">travel </span><span data-c={`${c.id}-md`}>—</span></span>
                  <span class="compare__v mono"><span class="visually-hidden">robust </span><span data-c={`${c.id}-ft`}>—</span></span>
                </button>
              ))
            }
          </div>
