              <span class="compare__name"><span class="compare__swatch" aria-hidden="true"></span>You</span>
              {
                ['tl', 'md', 'ft'].map((k) => (
                  <span class="compare__v mono">
                    <span class="visually-hidden">{k === 'tl' ? 'cost ' : k === 'md' ? 'travel ' : 'robust '}</span>
                    <span data-you={k}>—</span>
                    <span class="score__o" data-o={k}></span>
                  </span>
                ))
              }
            </div>
            <div class="compare__row score__row" data-score-row="mold">
              <span class="compare__name"><span class="compare__swatch compare__swatch--none" aria-hidden="true"></span>Mold</span>
              {
                ['tl', 'md', 'ft'].map((k) => (
                  <span class="compare__v mono">
                    <span class="visually-hidden">{k === 'tl' ? 'cost ' : k === 'md' ? 'travel ' : 'robust '}</span>
                    <span data-mold={k}>?</span>
                  </span>
                ))
              }
            </div>
          </div>
