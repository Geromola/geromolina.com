---
// Physarum (SPEC "Physarum"): a slime mold that builds transport networks between food.
import Base from '../layouts/Base.astro';
import TopBar from '../components/project/TopBar.astro';
import { grow, growthAt } from '../physarum/growth';
import { TOUR } from '../physarum/tour';
import { LEVELS } from '../physarum/challenge';

const SOURCES = [
  {
    title: 'Rules for biologically inspired adaptive network design',
    by: 'Tero, Takagi, Saigusa, Ito, Bebber, Fricker, Yumiki, Kobayashi & Nakagaki · Science, 2010',
    href: 'https://doi.org/10.1126/science.1177894',
  },
  {
    title: 'Maze-solving by an amoeboid organism',
    by: 'Nakagaki, Yamada & Tóth · Nature, 2000',
    href: 'https://doi.org/10.1038/35035159',
  },
  {
    title: 'Characteristics of pattern formation and evolution in approximations of Physarum transport networks',
    by: 'Jones · Artificial Life, 2010',
    href: 'https://doi.org/10.1162/artl.2010.16.2.16202',
  },
];

// The three stages of growth, drawn small with the page's own growth model: strands spreading
// from two foods and fusing in the middle, the route between them thickening while the rest
// fades, then that route alone.
const DIAGRAM_FOODS = [
  [10, 32],
  [90, 32],
];
const lat = { vx: [] as number[], vy: [] as number[], ea: [] as number[], eb: [] as number[], alive: [] as number[] };
for (let r = 0; r < 10; r++) {
  for (let c = 0; c < 15; c++) {
    lat.vx.push(3 + c * 6.8 + (r % 2 ? 3.4 : 0));
    lat.vy.push(3.5 + r * 6.3);
  }
}
for (let i = 0; i < lat.vx.length; i++) {
  for (let j = i + 1; j < lat.vx.length; j++) {
    if (Math.hypot(lat.vx[i] - lat.vx[j], lat.vy[i] - lat.vy[j]) > 7.3) continue;
    lat.ea.push(i);
    lat.eb.push(j);
    lat.alive.push(1);
  }
}
const nearest = ([x, y]: number[]) => lat.vx.reduce((best, _, v) => (Math.hypot(lat.vx[v] - x, lat.vy[v] - y) < Math.hypot(lat.vx[best] - x, lat.vy[best] - y) ? v : best), 0);
const diagramOrigins = DIAGRAM_FOODS.map(nearest);
const diagram = grow(lat, diagramOrigins, 5);
const grown = growthAt(diagram, lat, diagram.end);
// The route the flow keeps: from the first fusion back to each food.
const route = new Set<number>();
const meetAt = diagram.fuse[0];
if (meetAt !== undefined) {
  route.add(meetAt);
  for (let v of [lat.ea[meetAt], lat.eb[meetAt]]) {
    while (diagram.parent[v] >= 0) {
      route.add(diagram.via[v]);
      v = diagram.parent[v];
    }
  }
}
const strands = lat.ea.flatMap((a, e) => {
  if (!grown.fromA[e] && !grown.fromB[e]) return [];
  const b = lat.eb[e];
  return [{ x1: diagram.sx[a], y1: diagram.sy[a], x2: diagram.sx[b], y2: diagram.sy[b], weight: grown.weight[e], route: route.has(e) }];
});
const heaviest = Math.max(...strands.map((t) => t.weight));
type Strand = (typeof strands)[number];
const STAGE_PANELS = [
  { id: 'spread', name: 'Spread', say: 'strands reach out and fuse', width: (t: Strand) => 0.35 + 1.8 * Math.sqrt(t.weight / heaviest), show: () => true, faint: () => false },
  { id: 'thin', name: 'Thin out', say: 'the busy route widens, the rest fades', width: (t: Strand) => (t.route ? 2.4 : 0.45), show: () => true, faint: (t: Strand) => !t.route },
  { id: 'settled', name: 'Settled', say: 'only the useful tubes are left', width: () => 2.6, show: (t: Strand) => t.route, faint: () => false },
];

// The three lenses the page looks through (SPEC "Physarum", Design language).
const LENSES = [
  { id: 'nature', name: 'Nature', say: 'what the cell does', href: '#phys-nature' },
  { id: 'math', name: 'Math', say: 'the rules it follows', href: '#phys-math' },
  { id: 'engineering', name: 'Engineering', say: 'what its networks are worth', href: '#phys-engineering' },
] as const;
const LENS_NAME = { nature: 'Nature', math: 'Math', engineering: 'Engineering' } as const;

const COMPARE = [
  { id: 'none', name: 'Mold' },
  { id: 'rail', name: 'Rail lines' },
  { id: 'mst', name: 'Spanning tree' },
  { id: 'delaunay', name: 'Delaunay' },
];
---

<Base
  title="Physarum · Gero Molina"
  description="A slime mold with no brain builds networks as good as Tokyo's railways. Place food, paint light, cut tubes, and watch Physarum decide which connections to keep."
>
  <TopBar title="Physarum" />
  <main class="phys" data-physarum data-tool="food" data-sheet="peek" data-mode="sandbox">
    <div class="stage">
      <canvas class="stage__agents" data-agents aria-hidden="true"></canvas>
      <canvas
        class="stage__board"
        data-board
        tabindex="0"
        role="application"
        aria-roledescription="Slime mold board"
        aria-label="Slime mold board. Tap to place or remove food."
        aria-describedby="phys-keys"></canvas>
      <p class="plate" data-plate></p>
      <p class="visually-hidden" id="phys-keys">
        Arrow keys move the cursor, Shift and arrows move faster, Enter places or removes food with the Food tool and paints light with the Light tool. In the challenge, Enter starts and then lays a line with the Track tool (Escape cancels) and erases with the Erase tool. Space plays or pauses.
      </p>
    </div>

    <div class="dock glass" data-dock role="toolbar" aria-label="Simulation">
      <button class="tool tool--play" type="button" data-play aria-pressed="false" aria-label="Play">
        <svg class="i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4.2v11.6a.7.7 0 0 0 1.06.6l9.3-5.8a.7.7 0 0 0 0-1.2l-9.3-5.8A.7.7 0 0 0 6 4.2Z"></path></svg>
        <svg class="i-pause" viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="4" width="3.5" height="12" rx="1"></rect><rect x="11.5" y="4" width="3.5" height="12" rx="1"></rect></svg>
      </button>
      <button class="chip" type="button" data-converge data-not-challenge title="Run the model until the network stops changing">Skip ahead</button>
      <button class="chip" type="button" data-regrow data-not-challenge title="Grow the mold again from the food">Start over</button>
      <button class="chip chip--go" type="button" data-race data-challenge-only disabled title="Connect every town first">Race the mold</button>
      <button class="chip" type="button" data-undo data-challenge-only disabled>Undo</button>
      <span class="dock__sep" aria-hidden="true"></span>
      <div class="seg" role="group" aria-label="Tool">
        <button class="seg__b" type="button" data-tool-btn="food" aria-pressed="true">Food</button>
        <button class="seg__b" type="button" data-tool-btn="light" aria-pressed="false">Light</button>
        <button class="seg__b" type="button" data-tool-btn="cut" aria-pressed="false">Cut</button>
        <button class="seg__b" type="button" data-tool-btn="track" aria-pressed="false" data-challenge-only>Track</button>
        <button class="seg__b" type="button" data-tool-btn="erase" aria-pressed="false" data-challenge-only>Erase</button>
      </div>
      <span class="dock__sep" aria-hidden="true"></span>
      <label class="knob" data-not-challenge title="Flux driven through the network. Higher keeps more links.">
        <span class="knob__k mono">I₀</span>
        <input type="range" min="0" max="100" step="1" value="55" data-i0 />
        <span class="knob__v mono" data-i0-label>2.0</span>
      </label>
    </div>

    <aside class="panel glass" data-panel aria-labelledby="phys-title">
      <div class="grab" data-grab aria-hidden="true"><span></span></div>
      <header class="head" data-head>
        <p class="kicker">Field notes · <i>Physarum polycephalum</i></p>
        <h1 class="title" id="phys-title">Physarum</h1>
        <p class="lede">
          In 2010 a single cell with no brain was set down on a map of Tokyo. A day later it had grown a network about as cheap, as quick and nearly as tough as the railway engineers took a century to build. Watch it do it again.
        </p>
      </header>

      <div class="tabs" role="tablist" aria-label="Mode">
        <button class="tabs__b" type="button" role="tab" id="tab-sandbox" aria-controls="pane-sandbox" aria-selected="true" data-mode-btn="sandbox">Sandbox</button>
        <button class="tabs__b" type="button" role="tab" id="tab-tour" aria-controls="pane-tour" aria-selected="false" tabindex="-1" data-mode-btn="tour">Tour</button>
        <button class="tabs__b" type="button" role="tab" id="tab-tokyo" aria-controls="pane-tokyo" aria-selected="false" tabindex="-1" data-mode-btn="tokyo">Tokyo</button>
        <button class="tabs__b" type="button" role="tab" id="tab-challenge" aria-controls="pane-challenge" aria-selected="false" tabindex="-1" data-mode-btn="challenge">Challenge</button>
      </div>

      <section class="net" aria-label="The network" data-net data-stage="none">
        <p class="net__label"><span class="net__k">Specimen</span> <i>P. polycephalum</i>, on agar</p>
        <ol class="stages" role="list" aria-label="Growth">
          {
            STAGE_PANELS.map((p, i) => (
              <li class="stages__s" data-stage={p.id} data-state="next">
                <span class="stages__n mono">{i + 1}</span> {p.name}
              </li>
            ))
          }
        </ol>
        <p class="status" data-status data-kind="growing">Spreading out.</p>
        <dl class="metrics">
          <div class="metric">
            <dt class="metric__k">Cost</dt>
            <dd class="metric__v mono" data-m="tl">—</dd>
            <dd class="metric__note">length vs the shortest tree</dd>
          </div>
          <div class="metric">
            <dt class="metric__k">Travel</dt>
            <dd class="metric__v mono" data-m="md">—</dd>
            <dd class="metric__note">trip length vs the tree</dd>
          </div>
          <div class="metric">
            <dt class="metric__k">Robust</dt>
            <dd class="metric__v mono" data-m="ft">—</dd>
            <dd class="metric__note">links you can lose</dd>
          </div>
        </dl>
      </section>

      <div class="panes" data-panes>
        <section class="pane" id="pane-sandbox" role="tabpanel" aria-labelledby="tab-sandbox" data-pane="sandbox">
          <nav class="lenses" aria-label="Three ways to look">
            {
              LENSES.map((l) => (
                <a class="lenses__l" href={l.href} data-lens={l.id}>
                  <span class="lenses__k">{l.name}</span>
                  <span class="lenses__say">{l.say}</span>
                </a>
              ))
            }
          </nav>

          <p class="lens-tag" data-lens="nature">Nature</p>
          <h2 class="pane__title" id="phys-nature">What the slime mold does</h2>
          <p class="pane__body">
            <i>Physarum polycephalum</i> looks like a fungus but isn't one. It's a single giant cell, a yellow blob that can spread wider than your hand, with no brain and no nerves.
          </p>
          <p class="pane__body">
            It hunts by spreading out in a fan of fine tubes. Inside them its fluid sloshes back and forth every minute or two, carrying food around the cell. A tube that carries a lot of that flow grows wider. A tube that carries little shrinks, and in the end the mold pulls it back in.
          </p>
          <p class="pane__body">
            So once it has found a few pieces of food, the tubes between them stay busy and grow, and the rest wither away. Nobody plans the network. <b>Use it or lose it</b>, over and over, is enough. Footpaths across a lawn form the same way: the routes people walk most get worn in, and the rest grow back.
          </p>

          <h2 class="pane__title">Try it</h2>
          <ul class="how" role="list">
            <li><b>Food</b>: tap to place an oat flake, drag to move it, tap again to remove it.</li>
            <li><b>Light</b>: paint where the mold can't go, like mountains or sea. Paint over light to clear it.</li>
            <li><b>Cut</b>: slice through a tube and watch the flow find another way.</li>
            <li><b>I₀</b>: how hard the foods pump. Low gives a cheap tree, high a web of loops.</li>
            <li><b>Play</b> runs the rounds and pauses them. <b>Skip ahead</b> runs them until the network stops changing. <b>Start over</b> clears the mold and lets it spread again from the food.</li>
          </ul>
          <p class="pane__body">
            Moving food, painting light or cutting a tube doesn't start over. The mold adapts from where it is, as the real one would.
          </p>
          <div class="board-opts">
            <div class="seg" role="group" aria-label="Speed">
              <button class="seg__b" type="button" data-speed-btn="slow" aria-pressed="false">Slow</button>
              <button class="seg__b" type="button" data-speed-btn="normal" aria-pressed="true">Normal</button>
              <button class="seg__b" type="button" data-speed-btn="fast" aria-pressed="false">Fast</button>
            </div>
            <div class="board-opts__row">
              <button class="chip" type="button" data-example>Example board</button>
              <button class="chip" type="button" data-clear>Clear board</button>
              <button class="chip chip--go" type="button" data-go-mode="tour">Take the tour <span aria-hidden="true">→</span></button>
            </div>
          </div>

          <p class="lens-tag" data-lens="math">Math</p>
          <h2 class="pane__title" id="phys-math">The math</h2>
          <p class="pane__body">The computer copies the cell in four rounds, repeated hundreds of times a second:</p>
          <ol class="rounds" role="list">
            <li><b>Spread.</b> Strands reach out from every food, forking as they go, and fuse where they meet.</li>
            <li><b>Pump.</b> Two foods are picked at random. One pushes fluid in and the other drains it.</li>
            <li><b>Flow.</b> The fluid takes every route at once, most of it along the shortest, widest tubes, like water through pipes.</li>
            <li><b>Adjust.</b> Busy tubes widen a little and quiet ones narrow. Then two other foods pump.</li>
          </ol>
          <figure class="growth">
            {
              STAGE_PANELS.map((p, i) => (
                <div class="growth__p">
                  <svg viewBox="0 0 100 64" role="img" aria-label={`${p.name}: ${p.say}`}>
                    {strands
                      .filter((t) => p.show(t))
                      .map((t) => (
                        <line class="growth__tube" data-faint={p.faint(t) ? 'true' : undefined} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke-width={p.width(t)} />
                      ))}
                    {DIAGRAM_FOODS.map(([x, y]) => (
                      <ellipse class="growth__food" cx={x} cy={y} rx="4.6" ry="3.4" />
                    ))}
                  </svg>
                  <p class="growth__cap">
                    <span class="mono">{i + 1}</span> <b>{p.name}</b>: {p.say}
                  </p>
                </div>
              ))
            }
            <figcaption class="fig"><span class="fig__n">Fig. 1</span> The three stages, grown by the same model as the board. The bar at the top of this panel follows them live.</figcaption>
          </figure>

          <p class="pane__body">In Tero's model each tube <i>ij</i> has a length <i>L</i>, a conductivity <i>D</i> (how open it is) and carries a flux <i>Q</i>. Three rules do all the work:</p>
          <figure class="eqs">
            <div class="eq">
              <math display="block" aria-label="Q i j equals D i j over L i j, times p i minus p j">
                <msub><mi>Q</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub>
                <mo>=</mo>
                <mfrac><msub><mi>D</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><msub><mi>L</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub></mfrac>
                <mo stretchy="false">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo>−</mo><msub><mi>p</mi><mi>j</mi></msub><mo stretchy="false">)</mo>
              </math>
              <p class="eq__say"><b>Flow follows pressure.</b> A tube carries more the wider and shorter it is and the steeper the pressure drop: Ohm's law, for protoplasm.</p>
            </div>
            <div class="eq">
              <math display="block" aria-label="The sum over j of Q i j is plus I zero at the source, minus I zero at the sink, and zero elsewhere">
                <munder><mo>∑</mo><mi>j</mi></munder>
                <msub><mi>Q</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub>
                <mo>=</mo>
                <mrow>
                  <mo>{</mo>
                  <mtable>
                    <mtr><mtd><mo>+</mo><msub><mi>I</mi><mn>0</mn></msub></mtd><mtd><mtext>&nbsp;at the source</mtext></mtd></mtr>
                    <mtr><mtd><mo>−</mo><msub><mi>I</mi><mn>0</mn></msub></mtd><mtd><mtext>&nbsp;at the sink</mtext></mtd></mtr>
                    <mtr><mtd><mn>0</mn></mtd><mtd><mtext>&nbsp;elsewhere</mtext></mtd></mtr>
                  </mtable>
                </mrow>
              </math>
              <p class="eq__say"><b>Nothing is lost.</b> At every junction what flows in flows out (Kirchhoff's law), so what one food pumps in, the other takes out. Solving it gives every pressure <i>p</i>.</p>
            </div>
            <div class="eq">
              <math display="block" aria-label="d D i j by d t equals f of the absolute value of Q i j, minus D i j">
                <mfrac><mrow><mi>d</mi><msub><mi>D</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac>
                <mo>=</mo>
                <mi>f</mi><mo stretchy="false">(</mo><mo>|</mo><msub><mi>Q</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>|</mo><mo stretchy="false">)</mo>
                <mo>−</mo>
                <msub><mi>D</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub>
              </math>
              <math display="block" aria-label="where f of Q equals Q to the gamma over one plus Q to the gamma">
                <mi>f</mi><mo stretchy="false">(</mo><mi>Q</mi><mo stretchy="false">)</mo>
                <mo>=</mo>
                <mfrac><msup><mi>Q</mi><mi>γ</mi></msup><mrow><mn>1</mn><mo>+</mo><msup><mi>Q</mi><mi>γ</mi></msup></mrow></mfrac>
              </math>
              <p class="eq__say"><b>Use it or lose it.</b> A tube grows toward <i>f</i> of its flow and decays without it. <i>f</i> levels off, so no tube grows without limit; γ (1.8 here) sets how decisively the busy tubes win.</p>
            </div>
            <figcaption class="fig"><span class="fig__n">Fig. 2</span> Tero et al., <i>Science</i> 2010. <b>I₀</b>, the knob in the dock, is the flux each pair of foods pumps: gently, and the fluid can keep only a few tubes busy (a cheap tree); hard, and back-up routes stay busy too (loops).</figcaption>
          </figure>

          <p class="lens-tag" data-lens="engineering">Engineering</p>
          <h2 class="pane__title" id="phys-engineering">Cost against resilience</h2>
          <p class="pane__body">
            Every network trades three things. <b>Cost</b> is its total length, against the minimum spanning tree, the shortest network of straight links between foods. <b>Travel</b> is the average trip between two foods, against the same tree; under 1 is quicker. <b>Robust</b> is the share of links that can fail alone without cutting anything off. A tree is cheapest and scores 0%; a dense mesh survives anything but costs a fortune.
          </p>
          <figure class="tradeoff">
            <svg class="tf" data-tradeoff="sandbox" viewBox="0 0 320 190" role="img" aria-label="Cost against robustness for the spanning tree, the Steiner tree, the Delaunay mesh, Tokyo's rail network and the mold on this board"></svg>
            <figcaption class="fig"><span class="fig__n">Fig. 3</span> This board's networks, live. Engineers look for the top left: tough but cheap. The mold settles between the fragile trees and the costly mesh, close to where Tokyo's railway sits.</figcaption>
          </figure>
          <p class="pane__body">
            In the 2010 experiment Tokyo's rail network cost about 1.8× its tree, travelled 0.85×, and 96% of its links could fail alone without isolating a station. The mold's networks cost 1.75 ± 0.30×, travelled 0.85×, and were a little less robust. The Tokyo tab runs the experiment again.
          </p>

          <details class="curious">
            <summary>For the curious</summary>
            <p class="pane__body">
              <b>How it spreads.</b> The first stage is a shortest-path forest over random costs: every point on the board is reached the cheapest way from the nearest food, over ground a little different everywhere, which gives forking, wandering strands. They become the starting tubes of Tero's model, with a thin film everywhere else.
            </p>
            <p class="pane__body">
              <b>Two models, one picture.</b> The tubes are Tero's model, and every number comes from them. The grainy yellow growth is Jeff Jones's agent model, there for the look: hundreds of thousands of dots that each head for the strongest scent ahead and leave more behind, nudged along the tubes. Show either alone:
            </p>
            <div class="seg" role="group" aria-label="Show">
              <button class="seg__b" type="button" data-view-btn="mold" aria-pressed="false">Mold</button>
              <button class="seg__b" type="button" data-view-btn="tubes" aria-pressed="false">Tubes</button>
              <button class="seg__b" type="button" data-view-btn="both" aria-pressed="true">Both</button>
            </div>
            <p class="pane__body">
              <b>Time.</b> The real cell reverses its streaming about every 100 seconds and takes about a day to settle. Here the streaming is shown about 12× faster, and a settled network takes seconds.
            </p>
            <h3 class="pane__sub">Sources</h3>
            <ul class="sources" role="list">
              {
                SOURCES.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener">
                      <span class="sources__title">
                        {s.title} <span aria-hidden="true">↗</span>
                      </span>
                      <span class="sources__by">{s.by}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </section>
        <section class="pane" id="pane-tour" role="tabpanel" aria-labelledby="tab-tour" data-pane="tour" data-met="false" hidden>
          <nav class="steps" aria-label="Tour steps">
            {
              TOUR.map((s, i) => (
                <button class="steps__b mono" type="button" data-step-btn={s.id} data-done="false" aria-label={`Step ${i + 1}: ${s.title}`}>
                  {i + 1}
                </button>
              ))
            }
          </nav>
          {
            TOUR.map((s, i) => (
              <article class="step" data-tour-step={s.id} hidden={i > 0}>
                <p class="step__k">
                  <span class="mono">Step {i + 1} of {TOUR.length}</span>
                  <span class="lens-tag" data-lens={s.lens}>{LENS_NAME[s.lens]}</span>
                </p>
                <h2 class="pane__title step__title">{s.title}</h2>
                {s.body.map((para) => (
                  <p class="pane__body" set:html={para} />
                ))}
                {s.note && <p class="pane__note">{s.note}</p>}
                {s.goal && (
                  <p class="goal" data-goal data-met="false">
                    <span class="goal__mark" aria-hidden="true">
                      <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" /></svg>
                    </span>
                    <span class="goal__k mono">Goal</span>
                    <span>{s.goal}</span>
                    <span class="visually-hidden" data-goal-state>Not yet.</span>
                  </p>
                )}
                {s.readings && (
                  <dl class="readings">
                    {s.readings.map((r) => (
                      <div class="readings__r">
                        <dt class="readings__k mono">{r.label}</dt>
                        <dd class="readings__v mono" data-reading={r.mark}>
                          not yet
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
                {s.cards && (
                  <ul class="sources" role="list">
                    {s.cards.map((c) => (
                      <li>
                        <a href={c.href} target="_blank" rel="noopener">
                          <span class="sources__title">
                            {c.title} <span aria-hidden="true">↗</span>
                          </span>
                          <span class="sources__body">{c.body}</span>
                          <span class="sources__by">{c.by}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
