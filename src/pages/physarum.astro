                <button class="compare__row" type="button" data-compare={c.id} aria-pressed={c.id === 'rail' ? 'true' : 'false'}>
                  <span class="compare__name">
                    <span class={`compare__swatch compare__swatch--${c.id}`} aria-hidden="true"></span>
